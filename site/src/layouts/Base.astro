---
// The shell of every new page: fonts, design tokens, navbar and footer
// (_design/DESIGN.md). Pages put their content in the default slot.
import '@fontsource-variable/archivo/wdth.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/primitives.css';
import { loadLatestYear } from '@f1hub/shared/data/load';
import Footer from '../components/Footer.astro';
import ScrollThumb from '../components/ScrollThumb.astro';
import Navbar, { type NavPage } from '../components/Navbar.astro';
import { DATA_DIR } from '../lib/data';
import { href } from '../lib/paths';
import { LOCALES, DEFAULT_LOCALE, localePath, pathWithoutLocale, useI18n } from '../i18n';

interface Props {
    title: string;
    description: string;
    /** Section of the site, marked in the navbar. */
    current?: NavPage | undefined;
    /** Keep the page out of search engines (work-in-progress pages). */
    noindex?: boolean;
}

const { title, description, current, noindex = false } = Astro.props;
const season = loadLatestYear(DATA_DIR);
const { locale, t } = useI18n(Astro.currentLocale);
// This page in every language, for search engines (hreflang)
const pagePath = pathWithoutLocale(Astro.url.pathname);
const alternate = (code: (typeof LOCALES)[number]) => new URL(localePath(code, pagePath), Astro.site).href;
---

<!doctype html>
<html lang={locale} translate="no">
<head>
    <!-- Google tag (gtag.js), same property as the old pages -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-V7JKWRTE0S"></script>
    <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', 'G-V7JKWRTE0S');
    </script>
    <meta charset="utf-8" />
    <!-- Loading (DESIGN.md, Motion): every animation waits, paused at its
         first frame, until the font is in (at most 1.5 s), so the entrance
         wipe never runs in the fallback font and swaps letters halfway. No
         loading screen: the page is there, only the motion waits. -->
    <script is:inline>
        (function () {
            var root = document.documentElement;
            if (!document.fonts || !document.fonts.load) return;
            root.classList.add('is-loading');
            var ready = function () { root.classList.remove('is-loading'); };
            setTimeout(ready, 1500);
            // After the stylesheets: before them the font isn't declared yet
            // and load() would resolve at once, with nothing
            document.addEventListener('DOMContentLoaded', function () {
                document.fonts.load('900 1em "Archivo Variable"').then(ready, ready);
            });
        })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Mobile browsers paint their bars in the navbar's ink (--ink), so the
         page starts at the very top of the screen. -->
    <meta name="theme-color" content="#121212" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {LOCALES.map((code) => <link rel="alternate" hreflang={code} href={alternate(code)} />)}
    <link rel="alternate" hreflang="x-default" href={alternate(DEFAULT_LOCALE)} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={href('img/icon.png')} />
</head>
<body>
    <a class="sr" href="#main">{t.meta.skip}</a>
    <Navbar current={current} season={season} />
    <main id="main">
        <slot />
    </main>
    <Footer />
    <ScrollThumb />
</body>
</html>
