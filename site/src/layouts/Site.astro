---
// The shell of the new F1 Hub pages (20/11/2026): the published site's dark,
// its Formula 1 type, one content width (styles/f1.css) and the new navbar
// (components/SiteNav.astro). Pages are rebuilt on it section by section.
import '../styles/f1.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteNav, { type NavPage } from '../components/SiteNav.astro';
import { href } from '../lib/paths';
import { useI18n } from '../i18n';

interface Props {
    title: string;
    description: string;
    /** Section of the site, marked in the navbar. */
    current?: NavPage | undefined;
    /** Keep the page out of search engines (work-in-progress pages). */
    noindex?: boolean;
}

const { title, description, current, noindex = false } = Astro.props;
const { locale } = useI18n(Astro.currentLocale);
---

<!doctype html>
<html lang={locale} translate="no">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={href('img/icon.png')} />
    <link rel="preload" href={href('fonts/Formula1-Regular.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={href('fonts/Formula1-Black.woff2')} as="font" type="font/woff2" crossorigin />
</head>
<body>
    <SiteNav current={current} />
    <main id="top">
        <slot />
    </main>
    <SiteFooter />
</body>
</html>
