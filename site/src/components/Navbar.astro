---
// Site navbar (_design/DESIGN.md, section 5). Ink bar, sticky. Below 860 px the
// links move into a full-screen menu behind a "Menu" button.
//
// Live state: when <html data-weekend="live"> is set (by the script that reads
// the timetable, see DESIGN.md section 6), the Live link turns red and reads
// "Live now", and on mobile a red "Live" chip shows next to the Menu button.
import { href } from '../lib/paths';

export type NavPage = 'calendar' | 'results' | 'drivers' | 'teams' | 'live';

interface Props {
    /** The section this page belongs to, marked in the menu. */
    current?: NavPage | undefined;
    /** Season shown next to the logo. */
    season: number;
}

const { current, season } = Astro.props;

const links: { page: NavPage; label: string; to: string }[] = [
    { page: 'calendar', label: 'Calendar', to: '#calendar' },
    { page: 'results', label: 'Results', to: 'results.html' },
    { page: 'drivers', label: 'Drivers', to: 'drivers.html' },
    { page: 'teams', label: 'Teams', to: 'teams.html' },
];
---

<header class="nav" id="top">
    <div class="wrap nav__in">
        <a class="nav__logo" href={href('')} aria-label="F1 Hub, home">
            <img src={href('img/logo.png')} alt="F1 Hub" width="110" height="22" />
            <span class="nav__season lbl">Season {season}</span>
        </a>
        <a class="nav__chip lbl" href={href('live.html')}><span class="ldot" aria-hidden="true"></span>Live</a>
        <button class="nav__btn lbl" type="button" aria-expanded="false" aria-controls="nav-menu">Menu</button>
        <nav class="nav__menu" id="nav-menu" aria-label="Main">
            {links.map(({ page, label, to }) => (
                <a href={to.startsWith('#') ? href('') + to : href(to)} aria-current={current === page ? 'page' : undefined}>{label}</a>
            ))}
            <a class="nav__live" href={href('live.html')} aria-current={current === 'live' ? 'page' : undefined}>
                <span class="ldot" aria-hidden="true"></span>Live<span class="nav__now">&nbsp;now</span>
            </a>
        </nav>
    </div>
</header>

<script>
    const nav = document.querySelector<HTMLElement>('.nav');
    const button = nav?.querySelector<HTMLButtonElement>('.nav__btn');
    button?.addEventListener('click', () => {
        const open = nav!.classList.toggle('nav--open');
        button.setAttribute('aria-expanded', String(open));
        button.textContent = open ? 'Close' : 'Menu';
        document.body.style.overflow = open ? 'hidden' : '';
    });
</script>

<style>
    .nav {
        position: sticky;
        top: 0;
        z-index: 50;
        height: var(--nav);
        background: var(--ink);
        color: #fff;
        border-bottom: 1px solid #2a2a2a;
    }
    .nav__in {
        display: flex;
        align-items: center;
        gap: 24px;
        height: 100%;
    }
    .nav__logo {
        display: flex;
        align-items: center;
        gap: 14px;
        text-decoration: none;
    }
    .nav__logo img { width: auto; height: 22px; }
    .nav__season {
        padding-left: 14px;
        border-left: 1px solid #3a3a3a;
        color: var(--mute-ink);
    }

    .nav__menu {
        display: flex;
        align-items: center;
        gap: 2px;
        margin-left: auto;
    }
    .nav__menu a {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        border: 1px solid transparent;
        color: #fff;
        font-size: 12px;
        font-weight: 700;
        font-stretch: 115%;
        text-transform: uppercase;
        letter-spacing: .09em;
        text-decoration: none;
        transition: all .2s ease;
    }
    .nav__menu a:hover { border-color: #fff; }
    .nav__menu a[aria-current='page'] { border-bottom-color: var(--red); }

    .nav__now { display: none; }
    :global(html[data-weekend='live']) .nav__live { background: var(--red); border-color: var(--red); }
    :global(html[data-weekend='live']) .nav__live .ldot { background: #fff; animation: beat 1.1s ease-in-out infinite; }
    :global(html[data-weekend='live']) .nav__now { display: inline; }

    .nav__chip, .nav__btn { display: none; }
    .nav__btn {
        margin-left: auto;
        padding: 8px 14px;
        border: 1px solid #fff;
        background: none;
        cursor: pointer;
    }

    @media (max-width: 860px) {
        .nav__season { display: none; }
        .nav__btn { display: block; }

        .nav__menu {
            position: fixed;
            inset: var(--nav) 0 0 0;
            display: none;
            flex-direction: column;
            align-items: stretch;
            gap: 0;
            padding: 12px var(--gut) 40px;
            overflow: auto;
            background: var(--paper);
            color: var(--ink);
        }
        .nav--open .nav__menu { display: flex; }
        .nav__menu a {
            padding: 14px 0;
            border: 0;
            border-bottom: 1px solid var(--ink);
            color: var(--ink);
            font-size: 56px;
            font-weight: 900;
            font-stretch: 62%;
            letter-spacing: -.005em;
            line-height: .9;
        }
        .nav__menu a:hover { border-color: var(--ink); color: var(--red); }
        .nav__menu a[aria-current='page'] { color: var(--red-ink); border-bottom-color: var(--ink); }
        .nav__menu .ldot { width: 14px; height: 14px; }
        :global(html[data-weekend='live']) .nav__live { background: none; color: var(--red-ink); }
        :global(html[data-weekend='live']) .nav__live .ldot { background: var(--red); }

        :global(html[data-weekend='live']) .nav__chip {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-left: auto;
            padding: 7px 10px;
            background: var(--red);
            color: #fff;
            text-decoration: none;
        }
        :global(html[data-weekend='live']) .nav__chip .ldot { background: #fff; animation: beat 1.1s ease-in-out infinite; }
        :global(html[data-weekend='live']) .nav__btn { margin-left: 0; }
    }
</style>
