---
// Site navbar (_design/DESIGN.md, section 5). An ink bar, sticky, with the
// logo, the season and a hamburger button at every width; the sections (the
// same as the homepage's Explore index) and the language switcher are in a
// full-screen menu that drops down from the bar.
//
// Live state: when <html data-weekend="live"> is set (by the script that reads
// the timetable, see DESIGN.md section 6), the Live link in the menu turns
// red and reads "Live now", and a red "Live" chip shows next to the button.
import { useI18n } from '../i18n';
import { href } from '../lib/paths';
import LangSwitch from './LangSwitch.astro';

// The pages a navbar link can mark as current. Calendar isn't one: it's a
// section of the homepage (#calendar), so it's never marked.
export type NavPage = 'results' | 'drivers' | 'teams' | 'championship' | 'archive' | 'live';

interface Props {
    /** The section this page belongs to, marked in the menu. */
    current?: NavPage | undefined;
    /** Season shown next to the logo. */
    season: number;
}

const { current, season } = Astro.props;
const { t, fill } = useI18n(Astro.currentLocale);
const s = t.sections;

// Every section, in the site's one order and groups (the same in the Explore
// index and the footer; _design/DESIGN.md, "Site sections"): the season in
// time order, the grid, then history. Live is drawn on its own (its dot and
// "now"); Hall of Fame has no page yet ("Soon").
type Item = { page: NavPage | 'calendar' | 'hallOfFame'; label: string; to: string | null };
const item = (page: Item['page'], label: string, to: string | null): Item => ({ page, label, to });
const groups: { title: string; items: Item[] }[] = [
    { title: t.footer.season, items: [
        item('calendar', s.calendar, '#calendar'),
        item('live', s.live, 'live.html'),
        item('results', s.results, 'results.html'),
        item('championship', s.championship, 'championship.html'),
    ] },
    { title: t.footer.grid, items: [
        item('drivers', s.drivers, 'drivers.html'),
        item('teams', s.teams, 'teams.html'),
    ] },
    { title: t.footer.history, items: [
        item('archive', s.archive, 'archive.html'),
        item('hallOfFame', s.hallOfFame, null),
    ] },
];
const target = (to: string) => (to.startsWith('#') ? href('') + to : href(to));
---

<header class="nav" id="top">
    <div class="wrap nav__in">
        <a class="nav__logo" href={href('')} aria-label={t.nav.home}>
            <img src={href('img/logo.png')} alt="F1 Hub" width="110" height="22" />
            <span class="nav__season lbl">{fill(t.nav.season, { year: season })}</span>
        </a>
        <a class="nav__chip lbl" href={href('live.html')}><span class="ldot" aria-hidden="true"></span>{s.live}</a>
        <button class="nav__btn" type="button" aria-expanded="false" aria-controls="nav-menu" data-open={t.nav.openMenu} data-close={t.nav.closeMenu}>
            <span class="sr" data-btn-label>{t.nav.openMenu}</span>
            <span class="burger" aria-hidden="true"><i></i><i></i><i></i></span>
        </button>
        <nav class="nav__menu" id="nav-menu" aria-label={t.nav.main}>
            {groups.map(({ title, items }) => (
                <div class="nav__grp">
                    <p class="nav__gh lbl">{title}</p>
                    {items.map(({ page, label, to }) =>
                        !to
                            ? <span class="nav__soon">{label}<span class="nav__tag lbl">{s.soon}</span></span>
                            : page === 'live'
                                ? (
                                    <a class="nav__live" href={target(to)} aria-current={current === page ? 'page' : undefined}>
                                        <span class="ldot" aria-hidden="true"></span>
                                        <span class="roll">
                                            <span>{label}<span class="nav__now">&nbsp;{s.liveNow}</span></span>
                                            <span aria-hidden="true">{label}<span class="nav__now">&nbsp;{s.liveNow}</span></span>
                                        </span>
                                    </a>
                                )
                                : (
                                    <a href={target(to)} aria-current={current === page ? 'page' : undefined}>
                                        <span class="roll"><span>{label}</span><span aria-hidden="true">{label}</span></span>
                                    </a>
                                ))}
                </div>
            ))}
            <div class="nav__lang lbl"><LangSwitch /></div>
        </nav>
    </div>
    <!-- Desktop: the page behind the side panel, dimmed; a click closes it -->
    <div class="nav__scrim" data-scrim></div>
</header>

<script>
    const nav = document.querySelector<HTMLElement>('.nav');
    const button = nav?.querySelector<HTMLButtonElement>('.nav__btn');
    const label = button?.querySelector<HTMLElement>('[data-btn-label]');
    function setOpen(open: boolean) {
        if (!nav || !button) return;
        nav.classList.toggle('nav--open', open);
        button.setAttribute('aria-expanded', String(open));
        // The labels come from the page's dictionary, on the button
        if (label) label.textContent = (open ? button.dataset['close'] : button.dataset['open']) ?? '';
        document.body.style.overflow = open ? 'hidden' : '';
        // For other parts of the page (the scroll thumb hides meanwhile)
        document.documentElement.toggleAttribute('data-menu-open', open);
    }
    button?.addEventListener('click', () => setOpen(!nav!.classList.contains('nav--open')));
    // Following a link (Calendar is on the same page), clicking outside the
    // side panel or Escape closes it.
    nav?.querySelectorAll('.nav__menu a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    nav?.querySelector('[data-scrim]')?.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && nav?.classList.contains('nav--open')) {
            setOpen(false);
            button?.focus();
        }
    });
</script>

<style>
    .nav {
        position: sticky;
        top: 0;
        z-index: 50;
        height: var(--nav);
        background: var(--ink);
        color: #fff;
        border-bottom: 1px solid #2a2a2a;
    }
    .nav__in {
        display: flex;
        align-items: center;
        gap: 24px;
        height: 100%;
    }
    .nav__logo {
        display: flex;
        align-items: center;
        gap: 14px;
        text-decoration: none;
    }
    .nav__logo img { width: auto; height: 22px; }
    .nav__season {
        padding-left: 14px;
        border-left: 1px solid #3a3a3a;
        color: var(--mute-ink);
    }


    /* The menu, at every width (owner's call, 13/10: eight sections and the
       language switcher were too much for the bar). It drops down from the
       bar like a blind (clip-path), with the links coming down a little with
       it; one transition for all, as in the rest of the component.
       visibility keeps it out of the tab order while closed and,
       transitioned, waits for the blind to close. */
    .nav__menu {
        position: fixed;
        inset: var(--nav) 0 0 0;
        display: flex;
        flex-direction: column;
        align-items: stretch;
        padding: 12px var(--gut) 40px;
        overflow: auto;
        background: var(--paper);
        color: var(--ink);
        visibility: hidden;
        clip-path: inset(0 0 100% 0);
        transition: all .35s ease;
    }
    .nav--open .nav__menu { visibility: visible; clip-path: inset(0); }
    .nav__menu > * { transform: translateY(-16px); transition: all .35s ease; }
    .nav--open .nav__menu > * { transform: none; }
    .nav__menu a, .nav__soon {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 0;
        border-bottom: 1px solid var(--ink);
        color: var(--ink);
        font-size: 48px;
        font-weight: 900;
        font-stretch: 62%;
        letter-spacing: -.005em;
        line-height: .9;
        text-transform: uppercase;
        text-decoration: none;
    }
    .nav__menu a[aria-current='page'] { color: var(--red-ink); }

    /* Hover (and keyboard focus): the label rolls up and a red copy rolls in
       from below. Everything in the component shares one transition. */
    .roll {
        display: inline-grid;
        overflow: hidden;
    }
    .roll > span {
        grid-area: 1 / 1;
        transition: all .35s ease;
    }
    .roll > span + span {
        color: var(--red);
        transform: translateY(100%);
    }
    .nav__menu a:is(:hover, :focus-visible) .roll > span:first-child { transform: translateY(-100%); }
    .nav__menu a:is(:hover, :focus-visible) .roll > span + span { transform: translateY(0); }

    /* Live: its dot, and "Live now" in red while a session runs */
    .nav__menu .ldot { width: 14px; height: 14px; }
    .nav__now { display: none; }
    :global(html[data-weekend='live']) .nav__now { display: inline; }
    :global(html[data-weekend='live']) .nav__live { color: var(--red-ink); }
    :global(html[data-weekend='live']) .nav__live .ldot { background: var(--red); animation: beat 1.1s ease-in-out infinite; }

    /* Hall of Fame has no page yet: muted, not a link, with a "Soon" tag */
    .nav__soon { color: var(--mute); }
    .nav__tag {
        padding: 2px 5px;
        border: 1px solid currentColor;
        font-size: 11px;
        font-weight: 700;
        font-stretch: 115%;
        letter-spacing: .09em;
    }

    /* Language switcher (LangSwitch): under the links, in label type */
    .nav__lang { padding: 22px 0 0; color: var(--ink); font-size: 14px; }

    .nav__btn {
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        margin: 0 -10px 0 auto;
        padding: 0;
        border: 0;
        background: none;
        color: #fff;
        cursor: pointer;
    }
    /* Three bars that turn into an X when the menu is open */
    .burger { display: grid; gap: 6px; width: 24px; }
    .burger i {
        display: block;
        height: 2px;
        background: currentColor;
        transition: all .35s ease;
    }
    .nav--open .burger i:nth-child(1) { transform: translateY(8px) rotate(45deg); }
    .nav--open .burger i:nth-child(2) { opacity: 0; }
    .nav--open .burger i:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }

    /* While a session is live, a red "● Live" chip stays in the bar, next to
       the button, so the live state shows without opening the menu */
    .nav__chip { display: none; }
    :global(html[data-weekend='live']) .nav__chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-left: auto;
        padding: 7px 10px;
        background: var(--red);
        color: #fff;
        text-decoration: none;
    }
    :global(html[data-weekend='live']) .nav__chip .ldot { background: #fff; animation: beat 1.1s ease-in-out infinite; }
    :global(html[data-weekend='live']) .nav__btn { margin-left: 0; }

    /* Group labels and the scrim are for the desktop side panel */
    .nav__gh, .nav__scrim { display: none; }

    @media (max-width: 760px) {
        .nav__season { display: none; }
    }

    /* Desktop: a calmer menu (owner's call, 13/10: the full-screen one, with
       its giant type, was too loud on a computer). A side panel on ink, like
       a continuation of the bar, slides in from the right over the dimmed
       page; the sections in their groups, at a reading size; the language
       switcher at the foot. Same one transition and rolling label. */
    @media (min-width: 761px) {
        .nav__menu {
            inset: var(--nav) 0 0 auto;
            width: min(440px, 100%);
            padding: 36px 40px 32px;
            border-left: 1px solid #2a2a2a;
            background: var(--ink);
            color: var(--paper);
            clip-path: inset(0 0 0 100%);
        }
        .nav__menu > * { transform: translateX(24px); }

        .nav__grp + .nav__grp { margin-top: 30px; }
        .nav__gh {
            display: block;
            margin: 0 0 6px;
            color: var(--mute-ink);
        }
        .nav__menu a, .nav__soon {
            padding: 11px 0;
            border-bottom-color: rgba(239, 234, 224, .14);
            color: var(--paper);
            font-size: 30px;
            line-height: 1;
        }
        .nav__menu a[aria-current='page'] { color: var(--red-hi); }
        .roll > span + span { color: var(--red-hi); }
        .nav__menu .ldot { width: 9px; height: 9px; }
        :global(html[data-weekend='live']) .nav__live { color: var(--red-hi); }
        .nav__soon { gap: 12px; color: var(--mute-ink); }
        .nav__tag { font-size: 10px; }

        /* The switcher at the foot of the panel, after a rule */
        .nav__lang {
            margin-top: auto;
            padding-top: 20px;
            border-top: 1px solid rgba(239, 234, 224, .14);
            color: var(--paper);
            font-size: 12px;
        }
        .nav__grp:nth-last-child(2) { margin-bottom: 32px; }

        .nav__scrim {
            position: fixed;
            inset: var(--nav) 0 0 0;
            z-index: -1;
            display: block;
            background: rgba(18, 18, 18, .45);
            visibility: hidden;
            opacity: 0;
            transition: all .35s ease;
        }
        .nav--open .nav__scrim { visibility: visible; opacity: 1; }
    }
</style>
