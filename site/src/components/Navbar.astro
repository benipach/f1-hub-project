---
// Site navbar (_design/DESIGN.md, section 5). Ink bar, sticky, with the same
// sections as the homepage's Explore index. Below 1100 px the links move into
// a full-screen menu that drops down from the bar behind a hamburger button.
//
// Live state: when <html data-weekend="live"> is set (by the script that reads
// the timetable, see DESIGN.md section 6), the Live link turns red and reads
// "Live now", and on mobile a red "Live" chip shows next to the button.
import { useI18n } from '../i18n';
import { href } from '../lib/paths';

export type NavPage = 'calendar' | 'results' | 'drivers' | 'teams' | 'championship' | 'archive' | 'live';

interface Props {
    /** The section this page belongs to, marked in the menu. */
    current?: NavPage | undefined;
    /** Season shown next to the logo. */
    season: number;
}

const { current, season } = Astro.props;
const { t, fill } = useI18n(Astro.currentLocale);
const s = t.sections;

// Every section, in the site's one order (the same in the Explore index and
// the footer; _design/DESIGN.md, "Site sections"): the season in time order
// (Calendar, Live, Results, Championship), the grid, then history. Live is
// drawn on its own (its dot and "now") in second place.
type Link = { page: NavPage; label: string; to: string };
const link = (page: NavPage, label: string, to: string): Link => ({ page, label, to });
const before: Link[] = [link('calendar', s.calendar, '#calendar')];
const after: Link[] = [
    link('results', s.results, 'results.html'),
    link('championship', s.championship, 'championship.html'),
    link('drivers', s.drivers, 'drivers.html'),
    link('teams', s.teams, 'teams.html'),
    link('archive', s.archive, 'archive.html'),
];
---

<header class="nav" id="top">
    <div class="wrap nav__in">
        <a class="nav__logo" href={href('')} aria-label={t.nav.home}>
            <img src={href('img/logo.png')} alt="F1 Hub" width="110" height="22" />
            <span class="nav__season lbl">{fill(t.nav.season, { year: season })}</span>
        </a>
        <a class="nav__chip lbl" href={href('live.html')}><span class="ldot" aria-hidden="true"></span>{s.live}</a>
        <button class="nav__btn" type="button" aria-expanded="false" aria-controls="nav-menu" data-open={t.nav.openMenu} data-close={t.nav.closeMenu}>
            <span class="sr" data-btn-label>{t.nav.openMenu}</span>
            <span class="burger" aria-hidden="true"><i></i><i></i><i></i></span>
        </button>
        <nav class="nav__menu" id="nav-menu" aria-label={t.nav.main}>
            {before.map(({ page, label, to }) => (
                <a href={to.startsWith('#') ? href('') + to : href(to)} aria-current={current === page ? 'page' : undefined}>
                    <span class="roll"><span>{label}</span><span aria-hidden="true">{label}</span></span>
                </a>
            ))}
            <a class="nav__live" href={href('live.html')} aria-current={current === 'live' ? 'page' : undefined}>
                <span class="ldot" aria-hidden="true"></span>
                <span class="roll">
                    <span>{s.live}<span class="nav__now">&nbsp;{s.liveNow}</span></span>
                    <span aria-hidden="true">{s.live}<span class="nav__now">&nbsp;{s.liveNow}</span></span>
                </span>
            </a>
            {after.map(({ page, label, to }) => (
                <a href={href(to)} aria-current={current === page ? 'page' : undefined}>
                    <span class="roll"><span>{label}</span><span aria-hidden="true">{label}</span></span>
                </a>
            ))}
            {/* No page yet: "Soon", like in the Explore index and the footer */}
            <span class="nav__soon">{s.hallOfFame}<span class="nav__tag lbl">{s.soon}</span></span>
        </nav>
    </div>
</header>

<script>
    const nav = document.querySelector<HTMLElement>('.nav');
    const button = nav?.querySelector<HTMLButtonElement>('.nav__btn');
    const label = button?.querySelector<HTMLElement>('[data-btn-label]');
    function setOpen(open: boolean) {
        if (!nav || !button) return;
        nav.classList.toggle('nav--open', open);
        button.setAttribute('aria-expanded', String(open));
        // The labels come from the page's dictionary, on the button
        if (label) label.textContent = (open ? button.dataset['close'] : button.dataset['open']) ?? '';
        document.body.style.overflow = open ? 'hidden' : '';
    }
    button?.addEventListener('click', () => setOpen(!nav!.classList.contains('nav--open')));
    // Following a link (Calendar is on the same page) or Escape closes it.
    nav?.querySelectorAll('.nav__menu a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && nav?.classList.contains('nav--open')) {
            setOpen(false);
            button?.focus();
        }
    });
    // Widening past the breakpoint while open would leave the page unscrollable.
    matchMedia('(min-width: 1101px)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });
</script>

<style>
    .nav {
        position: sticky;
        top: 0;
        z-index: 50;
        height: var(--nav);
        background: var(--ink);
        color: #fff;
        border-bottom: 1px solid #2a2a2a;
    }
    .nav__in {
        display: flex;
        align-items: center;
        gap: 24px;
        height: 100%;
    }
    .nav__logo {
        display: flex;
        align-items: center;
        gap: 14px;
        text-decoration: none;
    }
    .nav__logo img { width: auto; height: 22px; }
    .nav__season {
        padding-left: 14px;
        border-left: 1px solid #3a3a3a;
        color: var(--mute-ink);
    }

    .nav__menu {
        display: flex;
        align-items: center;
        gap: 2px;
        margin-left: auto;
    }
    .nav__menu a {
        position: relative;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        color: #fff;
        font-size: 12px;
        font-weight: 700;
        font-stretch: 115%;
        text-transform: uppercase;
        letter-spacing: .09em;
        text-decoration: none;
    }

    /* Hover (and keyboard focus): the label rolls up and a red copy rolls in
       from below, while a red rule draws itself left to right under the link.
       Everything in the component shares one transition. */
    .roll {
        display: inline-grid;
        overflow: hidden;
    }
    .roll > span {
        grid-area: 1 / 1;
        transition: all .35s ease;
    }
    .roll > span + span {
        color: var(--red-hi);
        transform: translateY(100%);
    }
    .nav__menu a:is(:hover, :focus-visible) .roll > span:first-child { transform: translateY(-100%); }
    .nav__menu a:is(:hover, :focus-visible) .roll > span + span { transform: translateY(0); }

    .nav__menu a::after {
        content: '';
        position: absolute;
        right: 14px;
        bottom: 2px;
        left: 14px;
        height: 2px;
        background: var(--red);
        clip-path: inset(0 100% 0 0);
        transition: all .35s ease;
    }
    .nav__menu a:is(:hover, :focus-visible)::after,
    .nav__menu a[aria-current='page']::after { clip-path: inset(0); }

    .nav__now { display: none; }
    :global(html[data-weekend='live']) .nav__live { background: var(--red); }
    :global(html[data-weekend='live']) .nav__live .ldot { background: #fff; animation: beat 1.1s ease-in-out infinite; }
    /* On the red block the copy and the rule are white */
    :global(html[data-weekend='live']) .nav__live .roll > span + span { color: #fff; }
    :global(html[data-weekend='live']) .nav__live::after { background: #fff; }
    :global(html[data-weekend='live']) .nav__now { display: inline; }

    /* Hall of Fame has no page yet: muted, not a link, with a "Soon" tag */
    .nav__soon {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        color: var(--mute-ink);
        font-size: 12px;
        font-weight: 700;
        font-stretch: 115%;
        text-transform: uppercase;
        letter-spacing: .09em;
    }
    .nav__tag { padding: 2px 5px; border: 1px solid currentColor; font-size: 9px; }

    .nav__chip, .nav__btn { display: none; }
    .nav__btn {
        place-items: center;
        width: 44px;
        height: 44px;
        margin: 0 -10px 0 auto;
        padding: 0;
        border: 0;
        background: none;
        color: #fff;
        cursor: pointer;
    }
    /* Three bars that turn into an X when the menu is open */
    .burger { display: grid; gap: 6px; width: 24px; }
    .burger i {
        display: block;
        height: 2px;
        background: currentColor;
        transition: all .35s ease;
    }
    .nav--open .burger i:nth-child(1) { transform: translateY(8px) rotate(45deg); }
    .nav--open .burger i:nth-child(2) { opacity: 0; }
    .nav--open .burger i:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }

    /* Eight sections: the season label goes first, then the links get tighter */
    @media (max-width: 1280px) {
        .nav__season { display: none; }
        .nav__menu a, .nav__soon { padding-right: 11px; padding-left: 11px; }
        .nav__menu a::after { right: 11px; left: 11px; }
    }

    @media (max-width: 1100px) {
        .nav__btn { display: grid; }

        /* The menu drops down from the bar like a blind (clip-path), with the
           links coming down a little with it; one transition for all, as in
           the rest of the component. visibility keeps it out of the tab
           order while closed and, transitioned, waits for the blind to close. */
        .nav__menu {
            position: fixed;
            inset: var(--nav) 0 0 0;
            flex-direction: column;
            align-items: stretch;
            gap: 0;
            padding: 12px var(--gut) 40px;
            overflow: auto;
            background: var(--paper);
            color: var(--ink);
            visibility: hidden;
            clip-path: inset(0 0 100% 0);
            transition: all .35s ease;
        }
        .nav--open .nav__menu { visibility: visible; clip-path: inset(0); }
        .nav__menu > * { transform: translateY(-16px); transition: all .35s ease; }
        .nav--open .nav__menu > * { transform: none; }
        .nav__menu a, .nav__soon {
            padding: 14px 0;
            border: 0;
            border-bottom: 1px solid var(--ink);
            color: var(--ink);
            font-size: 48px;
            font-weight: 900;
            font-stretch: 62%;
            letter-spacing: -.005em;
            line-height: .9;
        }
        .nav__soon { gap: 14px; color: var(--mute); }
        .nav__tag { font-size: 11px; font-weight: 700; font-stretch: 115%; letter-spacing: .09em; }
        /* Same roll, with the copy in large red; each link already has its
           own rule, so no drawn line here. */
        .nav__menu a::after { display: none; }
        .roll > span + span,
        :global(html[data-weekend='live']) .nav__live .roll > span + span { color: var(--red); }
        .nav__menu a[aria-current='page'] { color: var(--red-ink); }
        .nav__menu .ldot { width: 14px; height: 14px; }
        :global(html[data-weekend='live']) .nav__live { background: none; color: var(--red-ink); }
        :global(html[data-weekend='live']) .nav__live .ldot { background: var(--red); }

        :global(html[data-weekend='live']) .nav__chip {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-left: auto;
            padding: 7px 10px;
            background: var(--red);
            color: #fff;
            text-decoration: none;
        }
        :global(html[data-weekend='live']) .nav__chip .ldot { background: #fff; animation: beat 1.1s ease-in-out infinite; }
        :global(html[data-weekend='live']) .nav__btn { margin-left: 0; }
    }
</style>
