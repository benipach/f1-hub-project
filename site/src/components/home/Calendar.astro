---
// The season poster: the homepage calendar (_design/DESIGN.md, section 5).
// Three stats, a progress bar, and a grid of round cards: direction D,
// "Spec sheet", of the 13/10 exploration (_design/cards/). Each card is a
// data plate in bands divided by hairlines (the number and the layout; the
// name; the fields; the result), and every card shares the same four rows
// through subgrid, so the grid reads like a timing sheet. hero-state.ts turns
// the dates into the visitor's time zone ([data-range]), writes the countdowns
// ([data-cal-cd]) and the next round's live state ([data-cal-next]).
import { useI18n } from '../../i18n';
import type { PosterRound, SeasonPoster } from '../../lib/home';
import { href } from '../../lib/paths';
import TeamMark from '../TeamMark.astro';

interface Props {
    poster: SeasonPoster;
}

const { poster } = Astro.props;
const { season, rounds } = poster;
const { t, intl } = useI18n(Astro.currentLocale);
const c = t.calendar;
// The first and last rounds that are run (a cancelled one has no number)
const run = rounds.filter((r) => r.round !== null);
const first = run[0];
const last = run[run.length - 1];
const month = (iso: string | null) =>
    iso ? new Date(iso).toLocaleDateString(intl, { month: 'long', timeZone: 'UTC' }) : '';
const pad = (n: number) => String(n).padStart(2, '0');
const km = new Intl.NumberFormat(intl, { minimumFractionDigits: 3, maximumFractionDigits: 3 });
// The Grand Prix name on two lines, broken around the language's "Grand Prix"
// phrase, which never splits: "Chinese / Grand Prix", "Gran Premio / de China".
// Names without it ("500 Millas de Indianápolis") wrap on their own.
const twoLines = (name: string) => {
    const at = name.indexOf(c.gpPhrase);
    if (at < 0) return name;
    const phrase = c.gpPhrase.replace(/ /g, ' ');
    const before = name.slice(0, at).trim();
    const after = name.slice(at + c.gpPhrase.length).trim();
    return before ? `${before}\n${phrase}${after ? ` ${after}` : ''}` : `${phrase}\n${after}`;
};
const upcoming = (r: PosterRound) => r.status === 'next' || r.status === 'upcoming';
---

<section class="sec" id="calendar" aria-labelledby="cal-title">
    <div class="wrap">
        <header class="sec-head g12">
            <p class="sec-no lbl">{c.sectionNo}</p>
            <h2 class="sec-title cond" id="cal-title" style={`--len: ${Math.max(c.season.length, String(season).length)}`}>{c.season}<br />{season}</h2>
            <div class="sec-meta">
                <div class="stats lbl">
                    {/* Total, raced, to go (owner's call, 13/10: no count of cancelled
                        rounds; they still show in the bar and their cells). The
                        total is the rounds that are or will be run, so the three add up. */}
                    <div><b>{pad(poster.raced + poster.toGo)}</b><span>{c.total}</span></div>
                    <div><b>{pad(poster.raced)}</b><span>{c.raced}</span></div>
                    <div><b class="is-red">{pad(poster.toGo)}</b><span>{c.toGo}</span></div>
                </div>
            </div>
        </header>

        <div class="prog" style={`--rounds: ${rounds.length}`} aria-hidden="true">
            {rounds.map((r) => <i class={`prog--${r.status}`}></i>)}
        </div>
        {first && last && (
            <div class="prog-k lbl" aria-hidden="true">
                <span>R{first.round} · {first.city} · {month(first.weekendStart)}</span>
                <span>R{last.round} · {last.city} · {month(last.weekendStart)}</span>
            </div>
        )}

        <ol class="cal">
            {rounds.map((r) => (
                <li class={`rd rd--${r.status}`}>
                    <a href={href(`grandsprix/grandprix.html?gp=${r.id}`)}>
                        {/* Row 1, the plate: the number in its corner, the drawing beside it */}
                        <span class="rd__top">
                            {/* A cancelled Grand Prix has no round, so no number (owner, 14/10) */}
                            {r.round !== null && <span class="rd__no" aria-hidden="true">{pad(r.round)}</span>}
                            {r.sprint && <span class="rd__tag lbl">{c.sprint}</span>}
                            {r.layout
                                ? <img class="rd__trk" src={href(r.layout)} alt="" loading="lazy" decoding="async" />
                                : <span class="rd__none"><span class="lbl">{c.noLayout}</span></span>}
                        </span>

                        {/* Row 2, the name */}
                        <span class="rd__name">{twoLines(r.name)}</span>

                        {/* Row 3, the fields: place and dates | lap length */}
                        <span class="rd__f">
                            <span class="rd__cell">
                                <span class="rd__lab lbl">{r.city}</span>
                                <span class="rd__val" data-range="short" data-start={r.weekendStart} data-end={r.raceStart}></span>
                            </span>
                            <span class="rd__cell">
                                <span class="rd__lab lbl">{c.lapKm}</span>
                                <span class="rd__val">{r.lengthKm ? km.format(r.lengthKm) : '—'}</span>
                            </span>
                        </span>

                        {/* Row 4, the result: winner, countdown, live or cancelled */}
                        <span class="rd__res">
                            {r.status === 'done' && r.winner && (
                                <>
                                    <span class="rd__lab lbl">{c.winner}</span>
                                    <span class="rd__win">
                                        <TeamMark logo={r.winner.teamLogo} color={r.winner.teamColor} size={22} />
                                        <span class="rd__val">{r.winner.firstName} {r.winner.name}</span>
                                    </span>
                                </>
                            )}
                            {r.status === 'cancelled' && (
                                <>
                                    <span class="rd__lab lbl">{c.status}</span>
                                    <span class="rd__val">{c.cancelledRound}</span>
                                </>
                            )}
                            {upcoming(r) && (
                                <>
                                    <span class="rd__lab lbl">
                                        {r.status === 'next' && <span class="ldot rd__dot" data-cal-dot hidden></span>}
                                        <span data-cal-next={r.status === 'next' ? '' : undefined}>
                                            {r.status === 'next' ? `${t.live.next} · ${c.lightsOutIn}` : c.lightsOutIn}
                                        </span>
                                    </span>
                                    {r.raceStart && <span class="rd__val" data-cal-cd={r.raceStart}></span>}
                                    {r.status === 'next' && <span class="rd__val" data-cal-live hidden></span>}
                                </>
                            )}
                        </span>
                    </a>
                </li>
            ))}
        </ol>

        <div class="cal-foot lbl">
            <span>{c.legend}</span>
            <a href={href('archive.html')}>{c.archive} <span class="arrow">→</span></a>
        </div>
    </div>
</section>

<style>
    .sec { padding: 112px 0 120px; background: var(--paper); color: var(--ink); }
    .sec-head { align-items: end; row-gap: 20px; margin-bottom: 40px; }
    .sec-no { grid-column: 1 / 13; display: flex; align-items: center; gap: 14px; margin: 0; }
    .sec-no::after { content: ''; flex: 1; height: 1px; background: currentColor; }
    .sec-title { grid-column: 1 / 8; margin: 0; font-size: clamp(72px, 12vw, 196px); line-height: .8; }
    .sec-meta { grid-column: 8 / 13; }

    .stats { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--ink); }
    .stats > div { padding: 10px 0 0; }
    .stats > div + div { padding-left: 14px; border-left: 1px solid var(--ink); }
    .stats b {
        display: block;
        font-size: clamp(48px, 5vw, 76px);
        font-weight: 900;
        font-stretch: 62%;
        line-height: .85;
        letter-spacing: 0;
    }
    .stats .is-red { color: var(--red); }
    .stats span { color: var(--mute); }

    /* Progress: ink = raced, hatched = cancelled, red = next, outline = to come */
    .prog { display: grid; grid-template-columns: repeat(var(--rounds, 25), 1fr); gap: 3px; margin: 0 0 8px; }
    .prog i { height: 14px; background: var(--ink); }
    .prog .prog--cancelled { background: repeating-linear-gradient(135deg, var(--ink) 0 2px, transparent 2px 6px); }
    .prog .prog--next { background: var(--red); }
    .prog .prog--upcoming { background: transparent; box-shadow: inset 0 0 0 1px var(--ink); }
    .prog-k { display: flex; justify-content: space-between; gap: 12px; margin-bottom: 36px; color: var(--mute); }

    /* The grid, a table of the season: every card spans four rows of the
       parent grid and shares them through subgrid, so plate, name, fields and
       result line up across a whole row of cards, even when a name runs to
       three lines. */
    .cal {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        margin: 0;
        padding: 0;
        list-style: none;
        border-top: 4px solid var(--ink);
        border-left: 1px solid var(--ink);
    }
    .rd {
        display: grid;
        grid-row: span 4;
        grid-template-rows: subgrid;
        border-right: 1px solid var(--ink);
        border-bottom: 1px solid var(--ink);
    }
    .rd a {
        /* The card's own colours; states and hover swap them */
        --rule: rgba(18, 18, 18, .28);
        --soft: var(--mute);
        position: relative;
        isolation: isolate;
        display: grid;
        grid-row: 1 / -1;
        grid-template-rows: subgrid;
        color: var(--ink);
        text-decoration: none;
        background-color: transparent;
        transition: all .2s ease;
    }

    /* Row 1, the plate */
    .rd__top {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        grid-template-rows: 1fr auto;
        column-gap: 12px;
        padding: 14px 16px;
    }
    .rd__no {
        grid-column: 1;
        grid-row: 1;
        font-size: clamp(72px, 6.4vw, 96px);
        font-weight: 900;
        font-stretch: 62%;
        line-height: .74;
        letter-spacing: -.01em;
    }
    .rd__tag {
        grid-column: 1;
        grid-row: 2;
        justify-self: start;
        align-self: end;
        margin-top: 10px;
        padding: 3px 6px 2px;
        background: var(--ink);
        color: var(--paper);
        font-size: 10px;
        transition: all .2s ease;
    }
    .rd__trk {
        grid-column: 2;
        grid-row: 1 / 3;
        justify-self: end;
        align-self: center;
        width: 100%;
        height: 104px;
        object-fit: contain;
        object-position: right center;
        filter: brightness(0);
        transition: all .2s ease;
        /* Keeps the image on its own layer: without it Chromium creates and
           drops one when the filter starts and stops animating, and the
           layout flashes at both ends of the hover. */
        will-change: filter;
    }
    /* No drawing on file: an empty plate, framed and crossed, same footprint */
    .rd__none {
        grid-column: 2;
        grid-row: 1 / 3;
        position: relative;
        height: 104px;
        border: 1px solid var(--rule);
        background: linear-gradient(to top right, transparent calc(50% - .6px), var(--rule) 50%, transparent calc(50% + .6px));
        color: var(--soft);
        transition: all .2s ease;
    }
    .rd__none span { position: absolute; top: 7px; left: 8px; font-size: 10px; }

    /* Row 2, the name */
    .rd__name {
        align-self: end;
        padding: 4px 16px 14px;
        font-size: clamp(24px, 2vw, 30px);
        font-weight: 900;
        font-stretch: 62%;
        line-height: .9;
        text-transform: uppercase;
        white-space: pre-line;
        hyphens: auto;
    }

    /* Row 3, the fields, in a hairline grid edge to edge */
    .rd__f {
        display: grid;
        grid-template-columns: 5fr 3fr;
        border-top: 1px solid var(--rule);
        transition: all .2s ease;
    }
    .rd__cell { min-width: 0; padding: 9px 10px 11px 16px; }
    .rd__cell + .rd__cell { padding-right: 16px; padding-left: 10px; border-left: 1px solid var(--rule); transition: all .2s ease; }
    .rd__lab {
        display: block;
        overflow: hidden;
        color: var(--soft);
        font-size: 10.5px;
        white-space: nowrap;
        text-overflow: ellipsis;
        transition: all .2s ease;
    }
    /* The values in a lighter face than the display type around them (owner's
       call, 13/10: in the 900 condensed face the card looked too loaded):
       normal width, weight 500, as written */
    .rd__val {
        display: block;
        margin-top: 6px;
        overflow: hidden;
        font-size: clamp(16px, 1.25vw, 18px);
        font-weight: 500;
        line-height: 1.15;
        white-space: nowrap;
        text-overflow: ellipsis;
    }
    .rd__val[hidden] { display: none; }

    /* Row 4, the result */
    .rd__res {
        align-self: stretch;
        padding: 9px 16px 16px;
        border-top: 1px solid var(--rule);
        transition: all .2s ease;
    }
    .rd__res .rd__lab { display: flex; align-items: center; gap: 7px; }
    .rd__win { display: flex; align-items: center; gap: 8px; min-width: 0; margin-top: 6px; }
    .rd__win .rd__val { margin: 0; }
    .rd__dot { background: #fff; animation: beat 1.1s ease-in-out infinite; }
    .rd__dot[hidden] { display: none; }

    /* States. Upcoming: the drawing waits at 32 % */
    .rd--upcoming .rd__trk { opacity: .32; }

    /* Cancelled: hatched card, name struck through, drawing at 18 % */
    .rd--cancelled a { background-image: repeating-linear-gradient(135deg, transparent 0 11px, rgba(18, 18, 18, .07) 11px 12px); }
    .rd--cancelled .rd__name { text-decoration: line-through; text-decoration-thickness: 3px; }
    .rd--cancelled .rd__trk { opacity: .18; }
    .rd--cancelled .rd__none { opacity: .6; }
    .rd--cancelled .rd__f .rd__val { color: var(--soft); }

    /* Next (and live): the one red field on the screen, white drawing */
    .rd--next a { --rule: rgba(255, 255, 255, .5); --soft: #fff; background-color: var(--red); color: #fff; }
    .rd--next .rd__trk { filter: brightness(0) invert(1); }
    .rd--next .rd__tag { background: #fff; color: var(--red-ink); }

    /* Hover (reworked 29/10, owner: "mejorá el hover"): ink rises from the
       foot of the card like a curtain, drawing and rules turn paper, the
       number turns red. A red light lapping the circuit was tried and
       dropped (owner, 29/10). The ink is a layer under the content, so the cancelled cards'
       hatching stays put until it is covered (the layer carries its own). */
    .rd a::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background: var(--ink);
        transform: scaleY(0);
        transform-origin: bottom;
        transition: transform .38s cubic-bezier(.2, .7, .2, 1);
    }
    .rd--cancelled a::before { background: repeating-linear-gradient(135deg, transparent 0 11px, rgba(239, 234, 224, .08) 11px 12px) var(--ink); }
    .rd__no { transition: color .25s ease .08s, transform .38s cubic-bezier(.2, .7, .2, 1); }
    .rd a:hover { --rule: rgba(239, 234, 224, .3); --soft: var(--mute-ink); color: var(--paper); }
    .rd a:hover::before { transform: scaleY(1); }
    .rd a:hover .rd__no { color: var(--red-hi); transform: translateX(4px); }
    .rd a:hover .rd__trk { filter: brightness(0) invert(1); }
    .rd a:hover .rd__tag { background: var(--paper); color: var(--ink); }
    .rd--next a:hover .rd__tag { background: var(--red); color: #fff; }
    @media (prefers-reduced-motion: reduce) {
        .rd a::before { transition: none; }
    }

    .cal-foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; margin-top: 18px; color: var(--mute); }
    .cal-foot a { text-decoration: none; }

    @media (max-width: 1100px) {
        .sec-title, .sec-meta { grid-column: 1 / 13; }
        .cal { grid-template-columns: repeat(3, minmax(0, 1fr)); }
        .rd__no { font-size: 92px; }
        .rd__name { font-size: 30px; }
        .rd__val { font-size: clamp(16px, 2vw, 18px); }
    }

    /* Mobile, one row per round: number | name, dates, result | drawing. The
       plate and the fields open up (display: contents), so their pieces sit
       in the row's own grid. */
    @media (max-width: 760px) {
        .sec { padding: 72px 0 80px; }
        .sec-head { margin-bottom: 28px; }
        /* Capped so the longest word fits the width: "TEMPORADA" overflowed
           375 px by 30 px (28/10). A capital is ~.53 em wide in this type. */
        .sec-title { font-size: min(clamp(64px, 22vw, 120px), calc((100vw - 2 * var(--gut)) / (var(--len, 6) * .53))); }
        .prog { gap: 2px; }
        .prog i { height: 10px; }
        .prog-k { margin-bottom: 24px; }

        .cal { grid-template-columns: minmax(0, 1fr); border-left: 0; }
        .rd { display: block; grid-row: auto; border-right: 0; }
        .rd a {
            grid-template-columns: 52px minmax(0, 1fr) 84px;
            grid-template-rows: auto auto auto 1fr;
            column-gap: 12px;
            padding: 16px 8px;
        }
        .rd__top, .rd__f { display: contents; }
        .rd__no { grid-column: 1; grid-row: 1 / 3; align-self: start; font-size: 46px; line-height: .76; }
        .rd__tag { grid-column: 1; grid-row: 3 / 5; align-self: start; margin-top: 8px; padding: 2px 4px 1px; font-size: 9px; letter-spacing: .06em; }
        .rd__trk, .rd__none { grid-column: 3; grid-row: 1 / 5; align-self: center; height: 72px; }
        .rd__trk { object-position: center; }
        .rd__name { grid-column: 2; grid-row: 1; align-self: start; padding: 0; font-size: 21px; }
        .rd__cell { grid-column: 2; grid-row: 2; margin-top: 7px; padding: 0; }
        .rd__cell .rd__lab { font-size: 11px; }
        .rd__cell .rd__val { margin: 3px 0 0; color: var(--soft); font-size: 11px; font-weight: 700; font-stretch: 115%; letter-spacing: .09em; line-height: 1.2; text-transform: uppercase; }
        .rd__cell + .rd__cell { display: none; }
        .rd__res { grid-column: 2; grid-row: 3; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; margin-top: 10px; padding: 0; border: 0; }
        .rd__res .rd__val, .rd__win { margin: 0; font-size: 16px; }
        .rd--done .rd__res > .rd__lab { display: none; }
    }
</style>
