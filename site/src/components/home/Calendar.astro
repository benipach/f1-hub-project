---
// The season poster: the homepage calendar (_design/DESIGN.md, section 5).
// A grid of every round with its layout, name, place, dates and result, plus
// three stats and a progress bar. Dates are turned into the visitor's time
// zone by hero-state.ts ([data-range]), which also writes the next round's
// "in N days" / "Live now" line ([data-cal-next]).
import type { SeasonPoster } from '../../lib/home';
import { href } from '../../lib/paths';
import TeamMark from '../TeamMark.astro';

interface Props {
    poster: SeasonPoster;
}

const { poster } = Astro.props;
const { season, rounds } = poster;
const first = rounds[0];
const last = rounds[rounds.length - 1];
const month = (iso: string | null) =>
    iso ? new Date(iso).toLocaleDateString('en-GB', { month: 'long', timeZone: 'UTC' }) : '';
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="sec" id="calendar" aria-labelledby="cal-title">
    <div class="wrap">
        <header class="sec-head g12">
            <p class="sec-no lbl">01 — Calendar</p>
            <h2 class="sec-title cond" id="cal-title">Season<br />{season}</h2>
            <div class="sec-meta">
                <div class="stats lbl">
                    <div><b>{pad(poster.raced)}</b><span>Raced</span></div>
                    <div><b>{pad(poster.cancelled)}</b><span>Cancelled</span></div>
                    <div><b class="is-red">{pad(poster.toGo)}</b><span>To go</span></div>
                </div>
            </div>
        </header>

        <div class="prog" style={`--rounds: ${rounds.length}`} aria-hidden="true">
            {rounds.map((r) => <i class={`prog--${r.status}`} title={`R${r.round}`}></i>)}
        </div>
        {first && last && (
            <div class="prog-k lbl" aria-hidden="true">
                <span>R{first.round} · {first.city} · {month(first.weekendStart)}</span>
                <span>R{last.round} · {last.city} · {month(last.weekendStart)}</span>
            </div>
        )}

        <ol class="cal">
            {rounds.map((r) => (
                <li class:list={['rd', `rd--${r.status}`, { 'rd--latest': r.latest }]}>
                    <a href={href(`grandsprix/grandprix.html?gp=${r.id}`)}>
                        <span class="rd__no">{pad(r.round)}</span>
                        {r.sprint && <span class="rd__tag lbl">Sprint</span>}
                        {r.layout && <img class="rd__trk" src={href(r.layout)} alt="" loading="lazy" decoding="async" />}
                        <span class="rd__name">{r.name}{r.sprint && <span class="rd__sprint lbl">Sprint</span>}</span>
                        <span class="rd__sub lbl">
                            {r.city}{r.city && r.weekendStart && ' · '}
                            {r.weekendStart && r.raceStart && <span class="num" data-range data-start={r.weekendStart} data-end={r.raceStart}></span>}
                        </span>
                        <span class="rd__res">
                            {r.status === 'done' && r.winner && (
                                <><TeamMark logo={r.winner.teamLogo} color={r.winner.teamColor} size={18} /><span class="mark-text"><em>Winner</em> {r.winner.name}</span></>
                            )}
                            {r.status === 'cancelled' && 'Cancelled'}
                            {r.status === 'next' && (
                                <span class="rd__next">
                                    <span class="ldot rd__dot" data-cal-dot hidden></span>
                                    <span data-cal-next>Next</span>
                                </span>
                            )}
                            {r.status === 'upcoming' && <em>Upcoming</em>}
                        </span>
                    </a>
                </li>
            ))}
        </ol>

        <div class="cal-foot lbl">
            <span>Sprint = sprint weekend · Dates in your local time</span>
            <a href={href('archive.html')}>Seasons archive <span class="arrow">→</span></a>
        </div>
    </div>
</section>

<style>
    .sec { padding: 112px 0 120px; background: var(--paper); color: var(--ink); }
    .sec-head { align-items: end; row-gap: 20px; margin-bottom: 40px; }
    .sec-no { grid-column: 1 / 13; display: flex; align-items: center; gap: 14px; margin: 0; }
    .sec-no::after { content: ''; flex: 1; height: 1px; background: currentColor; }
    .sec-title { grid-column: 1 / 8; margin: 0; font-size: clamp(72px, 12vw, 196px); line-height: .8; }
    .sec-meta { grid-column: 8 / 13; }

    .stats { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--ink); }
    .stats > div { padding: 10px 0 0; }
    .stats > div + div { padding-left: 14px; border-left: 1px solid var(--ink); }
    .stats b {
        display: block;
        font-size: clamp(48px, 5vw, 76px);
        font-weight: 900;
        font-stretch: 62%;
        line-height: .85;
        letter-spacing: 0;
    }
    .stats .is-red { color: var(--red); }
    .stats span { color: var(--mute); }

    /* Progress: ink = raced, hatched = cancelled, red = next, outline = to come */
    .prog { display: grid; grid-template-columns: repeat(var(--rounds, 25), 1fr); gap: 3px; margin: 0 0 8px; }
    .prog i { height: 14px; background: var(--ink); }
    .prog .prog--cancelled { background: repeating-linear-gradient(135deg, var(--ink) 0 2px, transparent 2px 6px); }
    .prog .prog--next { background: var(--red); }
    .prog .prog--upcoming { background: transparent; box-shadow: inset 0 0 0 1px var(--ink); }
    .prog-k { display: flex; justify-content: space-between; margin-bottom: 36px; color: var(--mute); }

    .cal {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        margin: 0;
        padding: 0;
        list-style: none;
        border-top: 4px solid var(--ink);
        border-left: 1px solid var(--ink);
    }
    .rd { border-right: 1px solid var(--ink); border-bottom: 1px solid var(--ink); }
    .rd a {
        display: grid;
        grid-template-columns: 1fr auto;
        grid-template-rows: auto 1fr auto auto auto;
        height: 100%;
        min-height: 248px;
        padding: 14px 16px 16px;
        color: inherit;
        text-decoration: none;
        transition: all .2s ease;
    }
    .rd__no { grid-column: 1; grid-row: 1; font-size: 60px; font-weight: 900; font-stretch: 62%; line-height: .78; }
    .rd__tag { grid-column: 2; grid-row: 1; align-self: start; padding: 3px 6px; border: 1px solid currentColor; }
    .rd__trk {
        grid-column: 1 / 3;
        grid-row: 2;
        justify-self: end;
        align-self: center;
        width: auto;
        height: 84px;
        margin: 10px 0;
        filter: brightness(0);
        transition: all .2s ease;
        /* Keeps the image on its own layer: without it Chromium creates and
           drops one when the filter starts and stops animating, and the
           layout flashes at both ends of the hover. */
        will-change: filter;
    }
    .rd__name {
        grid-column: 1 / 3;
        grid-row: 3;
        font-size: 21px;
        font-weight: 800;
        font-stretch: 78%;
        line-height: 1.02;
        text-transform: uppercase;
    }
    .rd__sprint { display: none; }
    .rd__sub { grid-column: 1 / 3; grid-row: 4; margin-top: 4px; color: var(--mute); }
    .rd__res {
        grid-column: 1 / 3;
        grid-row: 5;
        display: flex;
        align-items: center;
        gap: 8px;
        min-height: 30px;
        margin-top: 12px;
        padding-top: 9px;
        border-top: 1px solid rgba(18, 18, 18, .22);
        font-size: 13px;
        font-weight: 600;
    }
    .rd__res em { color: var(--mute); font-style: normal; font-weight: 500; }

    /* Hover: the cell inverts to ink. background-color, not the background
       shorthand: the shorthand would also drop the cancelled cells' hatching
       at once while the color fades. */
    .rd a:hover { background-color: var(--ink); color: var(--paper); }
    .rd a:hover .rd__trk { filter: brightness(0) invert(1); }
    .rd a:hover .rd__sub, .rd a:hover .rd__res em { color: var(--mute-ink); }
    .rd a:hover .rd__res { border-color: rgba(239, 234, 224, .3); }
    .rd a:hover .sq { box-shadow: 0 0 0 1px rgba(239, 234, 224, .55); }

    .rd--upcoming .rd__trk { opacity: .32; }
    .rd--cancelled a { background-image: repeating-linear-gradient(135deg, transparent 0 11px, rgba(18, 18, 18, .07) 11px 12px); }
    .rd--cancelled .rd__name { text-decoration: line-through; text-decoration-thickness: 3px; }
    .rd--cancelled .rd__trk { opacity: .18; }
    .rd--cancelled .rd__res {
        color: var(--red-ink);
        font-size: 11px;
        font-weight: 700;
        font-stretch: 115%;
        letter-spacing: .09em;
        text-transform: uppercase;
    }
    .rd--next a { background-color: var(--red); color: #fff; }
    .rd--next .rd__trk { filter: brightness(0) invert(1); }
    .rd--next .rd__sub, .rd--next .rd__res em { color: #fff; }
    .rd--next .rd__res { border-color: rgba(255, 255, 255, .5); font-weight: 800; }
    .rd--next a:hover { background-color: var(--ink); }
    .rd--latest .rd__no { color: var(--red); }
    .rd__next { display: inline-flex; align-items: center; gap: 8px; }
    .rd__dot { background: #fff; animation: beat 1.1s ease-in-out infinite; }
    .rd__dot[hidden] { display: none; }

    .cal-foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; margin-top: 18px; color: var(--mute); }
    .cal-foot a { text-decoration: none; }

    @media (max-width: 1100px) {
        .sec-title, .sec-meta { grid-column: 1 / 13; }
        .cal { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }

    @media (max-width: 760px) {
        .sec { padding: 72px 0 80px; }
        .sec-head { margin-bottom: 28px; }
        .sec-title { font-size: clamp(64px, 22vw, 120px); }
        .prog { gap: 2px; }
        .prog i { height: 10px; }
        .prog-k { margin-bottom: 24px; }

        /* A list: number, name and place, result, small layout */
        .cal { grid-template-columns: minmax(0, 1fr); border-left: 0; }
        .rd { border-right: 0; }
        .rd a {
            grid-template-columns: 44px minmax(0, 1fr) auto 52px;
            grid-template-rows: auto auto;
            column-gap: 12px;
            align-items: center;
            min-height: 0;
            padding: 12px 8px;
        }
        .rd__no { grid-column: 1; grid-row: 1 / 3; font-size: 40px; }
        .rd__tag { display: none; }
        .rd__sprint { display: inline-block; margin-left: 8px; padding: 1px 4px; border: 1px solid currentColor; font-size: 9px; vertical-align: 3px; }
        .rd__name { grid-column: 2; grid-row: 1; font-size: 18px; }
        .rd__sub { grid-column: 2; grid-row: 2; margin-top: 2px; }
        .rd__res {
            grid-column: 3;
            grid-row: 1 / 3;
            justify-content: flex-end;
            max-width: 120px;
            min-height: 0;
            margin: 0;
            padding: 0;
            border: 0;
            font-size: 12px;
            text-align: right;
        }
        .rd__res em { display: none; }
        .rd--cancelled .rd__res { font-size: 10px; }
        .rd__trk { grid-column: 4; grid-row: 1 / 3; justify-self: center; height: 34px; margin: 0; }
    }
</style>
