---
// Homepage standings (_design/DESIGN.md, section 5), the "podium poster"
// chosen on 28/10 out of four proposals: the top three as photos standing on
// their steps (2-1-3), 4th to 10th as a row of columns under their team's
// color with a link to the full table, and the constructors in the same
// pieces (the leader as a wide red step, the rest as columns). Numbers come
// from buildStandings() (race and sprint points in the data); the sentence in
// the header is generated from them.
import { getImage } from 'astro:assets';
import { useI18n } from '../../i18n';
import type { StandingRow, Standings } from '../../lib/home';
import { href } from '../../lib/paths';
import TeamMark from '../TeamMark.astro';

interface Props {
    standings: Standings;
}

const { standings } = Astro.props;
const { drivers, teams, afterRound, rounds, toGo } = standings;
const { t, fill, plural } = useI18n(Astro.currentLocale);
const st = t.standings;

const lead = (rows: readonly StandingRow[]) => {
    const [first, second] = rows;
    return first && second ? first.points - second.points : 0;
};
const [d1] = drivers;
const [t1, ...teamRest] = teams;
const summary = d1 && t1
    ? fill(st.summary, {
        driver: d1.name,
        points: plural(st.points, lead(drivers)),
        rounds: plural(st.rounds, toGo),
        team: t1.name,
        lead: lead(teams),
    })
    : '';
const pad = (n: number) => String(n).padStart(2, '0');
const maxDriver = d1?.points ?? 0;
const maxTeam = t1?.points ?? 0;

// The podium photos, resized at build time like the hero's winner (the
// sources are 1920×1080 PNGs of 2–5 MB); without one the step shows the logo
const covers = import.meta.glob<{ default: ImageMetadata }>('../../../../img/drivers/*-2.png');
const podium = await Promise.all(
    [drivers[1], drivers[0], drivers[2]]
        .filter((d): d is StandingRow => d !== undefined)
        .map(async (d) => {
            const loader = d.photo ? covers[`../../../../${d.photo}`] : undefined;
            const photo = loader ? await getImage({ src: (await loader()).default, width: 1000, format: 'webp', quality: 60 }) : null;
            return { ...d, image: photo };
        }),
);
const pack = drivers.slice(3, 10);
const leadTeamDrivers = t1 ? drivers.filter((d) => d.teamId === t1.teamId) : [];
---

<section class="sec on-ink" id="standings" aria-labelledby="ch-title">
    <div class="wrap">
        <header class="sec-head g12">
            <p class="sec-no lbl">{st.sectionNo}</p>
            <h2 class="sec-title cond" id="ch-title">{st.title}</h2>
            {summary && (
                <div class="sec-meta">
                    <p>{fill(st.after, { round: afterRound, rounds })} <b>{summary}</b></p>
                </div>
            )}
        </header>

        <!-- Ink and paper duotone of the driver pages (_design/driver, #duo) -->
        <svg class="defs" width="0" height="0" aria-hidden="true"><filter id="duo-standings" color-interpolation-filters="sRGB">
            <feColorMatrix type="matrix" values=".2126 .7152 .0722 0 0  .2126 .7152 .0722 0 0  .2126 .7152 .0722 0 0  0 0 0 1 0" />
            <feComponentTransfer><feFuncR type="table" tableValues=".0706 .9373" /><feFuncG type="table" tableValues=".0706 .9176" /><feFuncB type="table" tableValues=".0706 .8784" /></feComponentTransfer>
        </filter></svg>

        <ol class="podium" aria-label={st.drivers}>
            {podium.map((d) => (
                <li class:list={['step', `p${d.pos}`]} style={`--c: ${d.teamColor}`}>
                    <div class="photo">
                        {d.image
                            ? <><img src={d.image.src} width={d.image.attributes['width']} height={d.image.attributes['height']} alt="" loading="lazy" decoding="async" /><img class="photo__color" src={d.image.src} width={d.image.attributes['width']} height={d.image.attributes['height']} alt="" loading="lazy" decoding="async" /></>
                            : <span class="photo__mark"><TeamMark logo={d.teamLogo} color={d.teamColor} size={96} /></span>}
                        <span class="pos cond num"><small>P</small>{d.pos}</span>
                    </div>
                    <div class="block">
                        <p class="who">
                            {d.firstName && <span class="fn">{d.firstName}</span>}
                            <b class="ln cond">{d.name}</b>
                        </p>
                        <span class="tm"><TeamMark logo={d.teamLogo} color={d.teamColor} size={d.pos === 1 ? 34 : 30} /><span class="mark-text">{d.team}</span></span>
                        <p class="pts"><b class="cond num">{d.points}</b><span class="u">{st.pts}</span></p>
                        <dl class="stats">
                            {d.pos === 1
                                ? <><div><dt>{plural(st.wins, d.wins)}</dt><dd class="cond num">{d.wins}</dd></div><div><dt>{st.podiums}</dt><dd class="cond num">{d.podiums}</dd></div></>
                                : <><div><dt>{st.behind}</dt><dd class="cond num">{maxDriver - d.points}</dd></div><div><dt>{plural(st.wins, d.wins)}</dt><dd class="cond num">{d.wins}</dd></div></>}
                        </dl>
                    </div>
                </li>
            ))}
        </ol>

        {pack.length > 0 && (
            <div class="rest">
                <h3 class="lbl sub">{st.pack}</h3>
                <ol class="pack" start="4">
                    {pack.map((d) => (
                        <li style={`--c: ${d.teamColor ?? 'var(--mute-ink)'}`}>
                            <div class="pk-top">
                                <span class="pk-pos cond num">{pad(d.pos)}</span>
                                <TeamMark logo={d.teamLogo} color={d.teamColor} size={30} />
                            </div>
                            <p class="pk-who">
                                {d.firstName && <span class="pk-fn">{d.firstName}</span>}
                                <b class="pk-ln cond">{d.name}</b>
                            </p>
                            <p class="pk-pts"><b class="cond num">{d.points}</b><span class="u">{st.pts}</span></p>
                            <p class="pk-gap"><span>{st.behind}</span> <b class="cond num">{maxDriver - d.points}</b></p>
                        </li>
                    ))}
                </ol>
                <a class="all" href={href('championship.html')}>
                    <span class="all-k lbl">{st.full}</span>
                    <span class="all-t cond">{fill(st.all, { n: drivers.length })}</span>
                    <span class="all-a arrow" aria-hidden="true">→</span>
                </a>
            </div>
        )}

        {t1 && (
            <div class="cons">
                <header class="cons-head">
                    <p class="lbl sub-k">{st.constructors}</p>
                    <h3 class="cons-title cond">{st.teams}</h3>
                </header>

                <div class="lead-team">
                    <span class="lt-pos cond num"><small>P</small>1</span>
                    <p class="lt-who">
                        <TeamMark logo={t1.teamLogo} color={t1.teamColor} size={64} />
                        <b class="lt-name cond">{t1.name}</b>
                    </p>
                    <p class="pts lt-pts"><b class="cond num">{t1.points}</b><span class="u">{st.pts}</span></p>
                    <dl class="stats lt-stats">
                        <div><dt>{plural(st.wins, t1.wins)}</dt><dd class="cond num">{t1.wins}</dd></div>
                        <div><dt>{st.lead}</dt><dd class="cond num">{lead(teams)}</dd></div>
                        {leadTeamDrivers.map((d) => <div><dt>{d.name}</dt><dd class="cond num">{d.points}</dd></div>)}
                    </dl>
                </div>

                <ol class="pack five" start="2">
                    {teamRest.map((row) => (
                        <li style={`--c: ${row.teamColor ?? 'var(--mute-ink)'}`}>
                            <div class="pk-top">
                                <span class="pk-pos cond num">{pad(row.pos)}</span>
                                <TeamMark logo={row.teamLogo} color={row.teamColor} size={30} />
                            </div>
                            <p class="pk-who"><b class="pk-ln cond">{row.name}</b></p>
                            <p class="pk-pts"><b class="cond num">{row.points}</b><span class="u">{st.pts}</span></p>
                            <p class="pk-gap"><span>{st.behind}</span> <b class="cond num">{maxTeam - row.points}</b></p>
                        </li>
                    ))}
                </ol>
            </div>
        )}

        <div class="champ-foot">
            <a class="btn btn--red" href={href('championship.html')}>{st.full} <span class="arrow">→</span></a>
            <a class="btn btn--line" href={href('drivers.html')}>{t.sections.drivers}</a>
            <a class="btn btn--line" href={href('teams.html')}>{t.sections.teams}</a>
        </div>
    </div>
</section>

<style>
    .sec { padding: 112px 0 120px; background: var(--ink); color: var(--paper); }
    .sec-head { align-items: end; row-gap: 20px; margin-bottom: 48px; }
    .sec-no { grid-column: 1 / 13; display: flex; align-items: center; gap: 14px; margin: 0; color: var(--mute-ink); }
    .sec-no::after { content: ''; flex: 1; height: 1px; background: currentColor; }
    .sec-title { grid-column: 1 / 8; margin: 0; font-size: clamp(72px, 12vw, 196px); line-height: .8; }
    .sec-meta { grid-column: 8 / 13; }
    .sec-meta p { max-width: 36ch; margin: 0; font-size: 18px; line-height: 1.4; }
    .sec-meta b { color: var(--red-hi); font-weight: 600; }

    /* Podium: each photo on top of a solid step, bottom-aligned. The steps
       have podium heights, not point heights: the points are written on
       them. Paper steps for 2nd and 3rd, red for the leader. */
    .defs { position: absolute; }
    .podium {
        display: grid; grid-template-columns: 1fr 1.2fr 1fr; align-items: end; gap: var(--gap);
        margin: 0; padding: 0; list-style: none;
    }
    .step { --step: 340px; --soft: var(--mute); --rule: rgba(18, 18, 18, .2); }
    .step.p2 { --step: 380px; }
    .step.p1 { --step: 440px; --soft: rgba(255, 255, 255, .82); --rule: rgba(255, 255, 255, .4); }

    .photo { position: relative; height: 250px; overflow: hidden; background: var(--ink-2); }
    .p1 .photo { height: 280px; }
    .photo img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 55% 25%; filter: url(#duo-standings); }
    .photo img.photo__color { position: absolute; inset: 0; filter: none; opacity: 0; }
    .photo__mark { display: grid; place-items: center; height: 100%; }
    /* Position tab in the step's color, on the photo's bottom-left corner */
    .pos {
        position: absolute; left: 0; bottom: 0;
        display: grid; place-items: center; width: 72px; height: 72px;
        background: var(--paper); color: var(--ink); font-size: 50px; line-height: 1;
    }
    .pos small { position: absolute; top: 0; left: 12px; margin-top: .5em; font-size: .46em; }
    .p1 .pos { width: 88px; height: 88px; background: var(--red); color: #fff; font-size: 62px; }

    .block {
        display: flex; flex-direction: column;
        height: var(--step); padding: 22px 24px 20px;
        background: var(--paper); color: var(--ink);
    }
    .p1 .block { padding: 26px 28px 22px; background: var(--red); color: #fff; }
    .who { margin: 0; }
    .fn { display: block; margin-bottom: 6px; color: var(--soft); font-size: 20px; font-weight: 600; line-height: 1; }
    .p1 .fn { font-size: 24px; }
    .ln { display: block; font-size: clamp(48px, 4.8vw, 72px); line-height: .84; }
    .p1 .ln { font-size: clamp(64px, 6.6vw, 100px); }
    .tm {
        display: flex; align-items: center; gap: 12px; margin-top: 16px;
        font-size: 17px; font-weight: 700; font-stretch: 105%; letter-spacing: .06em; text-transform: uppercase;
    }
    .p1 .tm { font-size: 19px; }
    .pts { display: flex; align-items: baseline; gap: 10px; margin: auto 0 0; }
    .pts b { font-size: clamp(84px, 8vw, 120px); line-height: .76; }
    .p1 .pts b { font-size: clamp(112px, 11.6vw, 176px); }
    .u { font-size: 18px; font-weight: 800; font-stretch: 100%; letter-spacing: .06em; text-transform: uppercase; }
    /* Figures in a row split by hairlines (owner's favorite part, 28/10) */
    .stats { display: flex; margin: 18px 0 0; padding-top: 12px; border-top: 1px solid var(--rule); }
    .stats div { display: flex; align-items: baseline; gap: 8px; padding-right: 18px; }
    .stats div + div { padding-left: 18px; border-left: 1px solid var(--rule); }
    .stats dt { color: var(--soft); font-size: 13px; font-weight: 700; font-stretch: 105%; letter-spacing: .06em; text-transform: uppercase; }
    .stats dd { margin: 0; font-size: 34px; line-height: .8; }

    /* Hover (owner, 29/10): the step rises, the photo comes out of the
       duotone into color and a rule in the team's color runs across the top
       of the block. Only where there is a real pointer. */
    .block { position: relative; }
    .block::before {
        content: ""; position: absolute; top: 0; left: 0; right: 0; height: 6px;
        background: var(--c); transform: scaleX(0); transform-origin: left;
    }
    @media (hover: hover) and (prefers-reduced-motion: no-preference) {
        .step { transition: transform .35s cubic-bezier(.2, .7, .2, 1); }
        .photo img { transition: transform .6s cubic-bezier(.2, .7, .2, 1), opacity .4s ease; }
        .block::before { transition: transform .4s cubic-bezier(.2, .7, .2, 1) .05s; }
    }
    @media (hover: hover) {
        .step:hover { transform: translateY(-14px); }
        .step:hover .photo img { transform: scale(1.05); }
        .step:hover .photo__color { opacity: 1; }
        .step:hover .block::before { transform: scaleX(1); }
    }

    .rest { margin-top: 72px; }
    .sub { margin: 0; padding-bottom: 10px; color: var(--mute-ink); }

    /* The chasing pack: seven columns, each under a 4 px rule in its team's
       color (owner, 28/10: bars of points at the foot were too heavy) */
    .pack { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); margin: 0; padding: 0; list-style: none; }
    .pack li {
        display: flex; flex-direction: column; padding: 18px 16px 22px;
        border-top: 4px solid var(--c); border-right: 1px solid var(--rule-ink-soft);
    }
    .pack li:last-child { border-right: 0; }
    /* Hover (owner, 29/10): the team's color floods down from its rule as a
       tint, and the position number lights up */
    .pack li { position: relative; isolation: isolate; }
    .pack li::before {
        content: ""; position: absolute; inset: 0; z-index: -1;
        background: linear-gradient(color-mix(in srgb, var(--c) 34%, transparent), color-mix(in srgb, var(--c) 10%, transparent));
        transform: scaleY(0); transform-origin: top;
    }
    @media (hover: hover) and (prefers-reduced-motion: no-preference) {
        .pack li::before { transition: transform .4s cubic-bezier(.2, .7, .2, 1); }
        .pk-pos { transition: color .25s ease; }
    }
    @media (hover: hover) {
        .pack li:hover::before { transform: scaleY(1); }
        .pack li:hover .pk-pos { color: var(--paper); }
    }
    .pk-top { display: flex; align-items: center; justify-content: space-between; }
    .pk-pos { color: var(--mute-ink); font-size: 40px; line-height: .8; }
    .pk-who { margin: 18px 0 0; }
    .pk-fn { display: block; margin-bottom: 6px; color: var(--mute-ink); font-size: 15px; font-weight: 600; line-height: 1; }
    /* The ellipsis clips: padding gives descenders and accents room inside it */
    .pk-ln {
        display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
        padding-block: .1em; margin-block: -.1em;
        font-size: clamp(26px, 2.3vw, 34px); line-height: .9;
    }
    .pk-pts { display: flex; align-items: baseline; gap: 6px; margin: 26px 0 0; }
    .pk-pts b { font-size: clamp(48px, 4.4vw, 64px); line-height: .8; }
    .pk-pts .u { font-size: 13px; }
    .pk-gap { display: flex; align-items: baseline; gap: 6px; margin: 10px 0 0; padding-top: 10px; border-top: 1px solid var(--rule-ink); }
    .pk-gap span { color: var(--mute-ink); font-size: 12px; font-weight: 700; font-stretch: 105%; letter-spacing: .06em; text-transform: uppercase; }
    .pk-gap b { font-size: 22px; line-height: .8; }

    /* Link to the full table (the home shows the top ten): a band across */
    .all {
        display: flex; align-items: center; gap: 24px;
        padding: 22px 4px; border-top: 1px solid var(--rule-ink); border-bottom: 1px solid var(--rule-ink);
        color: var(--paper); text-decoration: none; transition: all .2s ease;
    }
    .all:hover { padding-inline: 24px; background: var(--red); border-color: var(--red); }
    .all-k { color: var(--mute-ink); transition: all .2s ease; }
    .all:hover .all-k { color: #fff; }
    .all-t { font-size: clamp(36px, 3.6vw, 56px); line-height: .8; }
    .all-a { margin-left: auto; font-size: 40px; line-height: 1; }

    /* Constructors: a heading of their own, then the leader as a wide red
       step and the rest as pack columns, five to a row */
    .cons { margin-top: 112px; }
    .cons-head { display: flex; align-items: end; justify-content: space-between; gap: 16px; margin-bottom: 28px; }
    .sub-k { order: 2; margin: 0; color: var(--mute-ink); }
    .cons-title { margin: 0; font-size: clamp(56px, 6vw, 96px); line-height: .8; }

    .lead-team {
        --soft: rgba(255, 255, 255, .82);
        --rule: rgba(255, 255, 255, .4);
        display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: end; column-gap: 32px;
        padding: 28px 28px 22px; background: var(--red); color: #fff;
    }
    .lt-pos { align-self: start; font-size: 84px; line-height: .8; }
    .lt-pos small { margin-right: .04em; font-size: .46em; vertical-align: top; }
    .lt-who { display: flex; align-items: center; gap: 18px; min-width: 0; margin: 0; }
    .lt-name { font-size: clamp(56px, 6vw, 96px); line-height: .84; }
    .lt-pts b { font-size: clamp(112px, 11.6vw, 176px); }
    .lt-stats { grid-column: 1 / -1; }

    .pack.five { grid-template-columns: repeat(5, minmax(0, 1fr)); row-gap: 2px; margin-top: 2px; }
    .pack.five li:nth-child(5n) { border-right: 0; }

    .champ-foot { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 56px; }

    @media (max-width: 1100px) {
        .sec-title, .sec-meta { grid-column: 1 / 13; }
        .pack { grid-template-columns: repeat(4, minmax(0, 1fr)); }
        .pack li:nth-child(4) { border-right: 0; }
        .pack li:nth-child(n + 5) { margin-top: 2px; }
        .lead-team { grid-template-columns: auto minmax(0, 1fr); }
        .lt-pts { grid-column: 1 / -1; margin-top: 24px; }
        .pack.five { grid-template-columns: repeat(3, minmax(0, 1fr)); }
        .pack.five li:nth-child(n) { border-right: 1px solid var(--rule-ink-soft); }
        .pack.five li:nth-child(3n) { border-right: 0; }
    }

    @media (max-width: 760px) {
        .sec { padding: 72px 0 80px; }
        .sec-title { font-size: clamp(64px, 22vw, 120px); }
        .podium { grid-template-columns: 1fr; }
        .step.p1 { order: -1; }
        .photo, .p1 .photo { height: 200px; }
        .block, .p1 .block { height: auto; padding: 18px 18px 16px; }
        .pts { margin-top: 28px; }
        .ln { font-size: 52px; }
        .p1 .ln { font-size: 64px; }
        .pts b { font-size: 76px; }
        .p1 .pts b { font-size: 100px; }
        .pos { width: 60px; height: 60px; font-size: 42px; }
        .p1 .pos { width: 72px; height: 72px; font-size: 52px; }

        /* Pack columns become rows: position, name and points, the gap under */
        .pack, .pack.five { grid-template-columns: 1fr; row-gap: 0; }
        .pack li, .pack li:nth-child(n + 5), .pack.five li:nth-child(n) {
            display: grid; grid-template-columns: 44px minmax(0, 1fr) auto; align-items: center; column-gap: 12px;
            margin: 0; padding: 14px 10px 14px 14px;
            border: 0; border-left: 4px solid var(--c); border-bottom: 1px solid var(--rule-ink-soft);
        }
        .pk-top { grid-row: 1 / 3; }
        .pk-top :global(.team-mark), .pk-top :global(.sq) { display: none; }
        .pk-pos { font-size: 30px; }
        .pk-who { margin: 0; }
        .pk-fn { display: none; }
        /* Rows are wide enough to wrap a long name instead of cutting it ("Red Bull Racing") */
        .pk-ln { padding-block: 0; margin-block: 0; overflow: visible; white-space: normal; font-size: 26px; }
        .pk-pts { grid-column: 3; grid-row: 1; margin: 0; }
        .pk-pts b { font-size: 36px; }
        .pk-gap { grid-column: 2 / 4; grid-row: 2; margin: 6px 0 0; padding: 0; border: 0; }
        .all { gap: 14px; }
        .all-k { display: none; }

        .lead-team { grid-template-columns: minmax(0, 1fr); padding: 20px 18px 16px; }
        .lt-pos { font-size: 60px; }
        .lt-who { flex-direction: column; align-items: flex-start; gap: 14px; margin-top: 18px; }
        .lt-name { font-size: 44px; }
        .lt-pts { grid-column: 1; margin-top: 20px; }
        .lt-pts b { font-size: 100px; }
        /* Four figures: two per line, the hairline only between the two */
        .lt-stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 12px; }
        .lead-team .lt-stats div { padding: 0 0 0 14px; border-left: 1px solid var(--rule); }
        .lead-team .lt-stats div:nth-child(odd) { padding-left: 0; border-left: 0; }
    }
</style>
