---
// Homepage hero in its three states (_design/DESIGN.md, sections 5 and 6):
// upcoming (paper), live (red) and result (ink). All three are rendered at
// build time; hero-state.ts shows the one that fits the current time and
// keeps the countdowns and local times up to date.
import { getImage } from 'astro:assets';
import { useI18n } from '../../i18n';
import type { HomeHero } from '../../lib/home';
import { href } from '../../lib/paths';
import TeamMark from '../TeamMark.astro';

/** A row of the live top 10: position, driver, team, gap. */
export type TowerRow = {
    pos: number;
    firstName: string;
    lastName: string;
    team: string;
    teamColor: string | null;
    teamLogo: string | null;
    gap: string;
};

interface Props {
    hero: HomeHero;
    /** Preview pages only: accept ?now= to simulate another moment. */
    preview?: boolean;
    /**
     * Rows to show in the live top 10. Preview only: on the real page the live
     * feed fills them (the relay's top-10 endpoint, phase 4); until then they
     * read "—".
     */
    tower?: TowerRow[] | undefined;
    /**
     * Preview only: a race's total laps, to show an estimated "Lap 32 / 62"
     * from the elapsed time. On the real page the lap and the qualifying
     * part and clock come from the live feed (phase 4) through data
     * attributes on the root (see hero-state.ts).
     */
    previewLaps?: number | undefined;
}

const { hero, preview = false, tower, previewLaps } = Astro.props;
const { next, last, rounds } = hero;
const { t, fill, intl, heroWords } = useI18n(Astro.currentLocale);
const h = t.hero;
const tb = t.table;
// The live state's giant line: "LIVE RACE" in English, "CARRERA EN VIVO" in Spanish
const liveFirst = h.liveLine.indexOf('{live}') < h.liveLine.indexOf('{session}');
// "4.928" in English, "4,928" in Spanish
const kmFormat = new Intl.NumberFormat(intl, { minimumFractionDigits: 3, maximumFractionDigits: 3 });
const race = next?.sessions.find((s) => s.key === 'race');
const towerRows: (TowerRow | null)[] = Array.from({ length: 10 }, (_, i) => tower?.[i] ?? null);

// What the browser script needs: the timetable of the next Grand Prix and
// when the last race ended.
const state = {
    sessions: next?.sessions ?? [],
    lastRaceEnd: last?.raceEnd ?? null,
    preview,
    previewLaps: preview ? previewLaps ?? null : null,
    gpName: next?.name ?? '',
    words: heroWords(),
    intl,
};

// The winner's photo, resized at build time: the source files are 1920×1080
// PNGs of 2–5 MB, the block shows ~440 px of them (DESIGN.md, Result).
const covers = import.meta.glob<{ default: ImageMetadata }>('../../../../img/drivers/*-2.png');
const coverLoader = last?.winnerPhoto ? covers[`../../../../${last.winnerPhoto}`] : undefined;
const winnerPhoto = coverLoader
    ? await getImage({ src: (await coverLoader()).default, width: 1000, format: 'webp', quality: 60 })
    : null;

const [podium1, podium2, podium3] = last?.rows ?? [];
const rest = last?.rows.slice(3) ?? [];
---

<div class="hero-root" data-hero-root>
    {next && (
        <section class="hero hero--up" data-hero="upcoming" aria-labelledby="up-title">
            <div class="wrap">
                <div class="strip lbl">
                    <span class="tag"><span class="sq" style="--c: var(--red)"></span><span data-up-tag>{h.nextRace}</span></span>
                    <span>{fill(h.roundOf, { round: next.round, rounds })}</span>
                    <span class="grow">{[next.circuit, next.place].filter(Boolean).join(' — ')}</span>
                    {next.sessions[0] && race && (
                        <span class="num" data-range data-start={next.sessions[0].start} data-end={race.start}></span>
                    )}
                </div>

                <div class="up g12">
                    <div class="up__head">
                        <div class="roundel" aria-hidden="true">{next.round}</div>
                        <div>
                            <p class="up__kicker lbl">{fill(h.kicker, { round: next.round })}{next.sprint && ` · ${h.sprintWeekend}`}</p>
                            <h1 class="up__title cond" id="up-title">{next.name}</h1>
                        </div>
                    </div>

                    <div class="up__track">
                        {next.layout && <div class="trk" set:html={next.layout} />}
                        {(next.length || next.turns || next.raceLaps || next.lapRecord) && (
                            <div class="facts lbl">
                                {next.length && <div><b>{kmFormat.format(next.length)}</b><span>{h.kmLap}</span></div>}
                                {next.turns && <div><b>{next.turns}</b><span>{h.turns}</span></div>}
                                {next.raceLaps && <div><b>{next.raceLaps}</b><span>{h.laps}</span></div>}
                                {next.lapRecord && (
                                    <div>
                                        <b>{next.lapRecord.time}</b>
                                        <span>{h.lapRecord}</span>
                                        <span class="facts__by">{next.lapRecord.driver} {next.lapRecord.year}</span>
                                    </div>
                                )}
                            </div>
                        )}
                    </div>

                    <div class="up__count" role="timer" aria-labelledby="next-lbl" data-countdown-block>
                        <div class="head lbl">
                            <span id="next-lbl">{h.nextSession} — <b data-next-name>—</b> {h.startsIn}</span>
                            <span class="num" data-next-when></span>
                        </div>
                        <div class="digits num" aria-hidden="true">
                            <span class="u"><span data-cd="d">00</span><small>{h.days}</small></span><span class="c">:</span>
                            <span class="u"><span data-cd="h">00</span><small>{h.hours}</small></span><span class="c">:</span>
                            <span class="u"><span data-cd="m">00</span><small>{h.minutes}</small></span><span class="c">:</span>
                            <span class="u"><span data-cd="s">00</span><small>{h.seconds}</small></span>
                        </div>
                        <span class="sr" data-cd-sr></span>
                    </div>

                    <div class="up__count up__wait" data-waiting hidden>
                        <p class="lbl">{h.weekendComplete}</p>
                        <p class="cond up__wait-title" style={`--chars: ${h.resultsOnTheWay.length}`}>{h.resultsOnTheWay}</p>
                    </div>

                    <div class="sched">
                        <h2 class="lbl"><b>{h.timetable}</b> <span>{h.yourTime} · <span data-tz>{h.local}</span></span></h2>
                        <ol>
                            {next.sessions.map((s) => (
                                <li data-session={s.key} class={s.key === 'race' ? 'is-race' : undefined}>
                                    <span class="day lbl" data-local="weekday" data-at={s.start}></span>
                                    <span class="nm">{s.name}</span>
                                    <span class="tm num" data-local="time" data-at={s.start}></span>
                                </li>
                            ))}
                        </ol>
                    </div>
                </div>
            </div>

            <div class="band on-ink">
                <div class="wrap band__in">
                    <span class="band__k lbl">{h.race}</span>
                    {race && <span class="band__v num" data-local="daytime" data-at={race.start}></span>}
                    <span class="band__rule" aria-hidden="true"></span>
                    <span class="band__k lbl">{h.lightsOutIn}</span>
                    <span class="band__v" data-race-count>—</span>
                    <a class="btn btn--red" href={href(`grandsprix/grandprix.html?gp=${next.id}`)}>{h.gpGuide} <span class="arrow">→</span></a>
                </div>
            </div>
        </section>
    )}

    {next && (
        <section class="hero hero--live" data-hero="live" aria-labelledby="live-title" hidden>
            <div class="wrap">
                <div class="strip lbl">
                    <span class="tag"><span class="ldot ldot--on"></span>{h.liveNow}</span>
                    <span>{fill(h.roundOf, { round: next.round, rounds })}</span>
                    <span class="grow">{next.name}<span class="hide-m"> — {next.circuit}</span></span>
                    {next.sprint && <span class="hide-m">{h.sprintWeekend}</span>}
                </div>

                <div class="live g12">
                    <div class="live__main">
                        <!-- The giant line: "LIVE" and the session, fitted to the
                             column by hero-state.ts (on two lines when that's bigger) -->
                        <div class="word" data-word aria-hidden="true">
                            <p class="word__line" data-word-line>
                                {liveFirst
                                    ? <><span>{h.liveWord}</span><span class="word__gap"> </span><span class="word__sess" data-live-name></span></>
                                    : <><span class="word__sess" data-live-name></span><span class="word__gap"> </span><span>{h.liveWord}</span></>}
                            </p>
                        </div>

                        <!-- The session's progress: a readout over the bar (laps, the
                             qualifying parts or the session clock) -->
                        <div class="prog">
                            <div class="prog__head lbl">
                                <h1 id="live-title" data-live-title></h1>
                                <span class="prog__zone" data-live-zone></span>
                            </div>
                            <div class="read">
                                <div class="read__main">
                                    <div>
                                        <span class="read__k lbl" data-read-k></span>
                                        <span class="read__v cond" data-read-v></span>
                                    </div>
                                    <span class="read__s lbl" data-read-s></span>
                                </div>
                                <div class="pair lbl"><span data-start-k></span><b class="num" data-start-v></b><span data-start-s></span></div>
                                <div class="pair lbl"><span>{h.ends}</span><b class="num" data-end-v></b><span data-end-s></span></div>
                            </div>
                            <div class="segs" data-segs role="progressbar" aria-labelledby="live-title" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>

                        <!-- The weekend's sessions on a line -->
                        <div class="wk">
                            <div class="wk__head lbl"><span>{h.weekend}</span>{next.sprint && <span>{h.sprintWeekend}</span>}</div>
                            <ol class="tl">
                                {next.sessions.map((s) => (
                                    <li class="tl__cell" data-wk={s.key}>
                                        <span class="tl__rail" aria-hidden="true"><span class="tl__fill" data-wk-fill></span></span>
                                        <span class="tl__st lbl"><span class="ldot ldot--on"></span><span class="tl__next">{t.live.next}</span><span class="tl__txt" data-wk-txt></span></span>
                                        <span class="tl__nm cond"><span class="l">{s.name}</span><span class="s" aria-hidden="true">{(h.sessionShort as Record<string, string>)[s.key] ?? s.name}</span></span>
                                        <span class="tl__when">
                                            <span class="tl__day lbl" data-local="daymonth" data-at={s.start}></span>
                                            <span class="tl__tm num"><span data-local="time" data-at={s.start}></span>–<span data-local="time" data-at={s.end}></span></span>
                                        </span>
                                    </li>
                                ))}
                            </ol>
                        </div>
                    </div>

                    <!-- The top 10, with the door to the Live page as its foot -->
                    <div class="tower" data-tower>
                        <h2 class="tower__hd lbl">
                            <span><span class="ldot ldot--red" aria-hidden="true"></span>{h.top10}</span>
                            <span class="tower__r" data-tower-label></span>
                        </h2>
                        <div class="top" role="table" aria-label={h.top10}>
                            <div class="tr th lbl" role="row">
                                <span role="columnheader">{tb.pos}</span>
                                <span role="columnheader">{tb.driver}</span>
                                <span role="columnheader" class="hide-m">{tb.team}</span>
                                <span role="columnheader" class="r">{tb.gap}</span>
                            </div>
                            {towerRows.map((row, i) => (
                                <div class="tr" role="row" data-tower-row>
                                    <span class="p" role="cell" data-pos>{row?.pos ?? i + 1}</span>
                                    <span class="d" role="cell">{row && <span class="d__mark"><TeamMark logo={row.teamLogo} color={row.teamColor} size={18} /></span>}<span class="f" data-first>{row?.firstName ?? ''}</span><span data-driver>{row?.lastName ?? '—'}</span></span>
                                    <span class="t hide-m" role="cell">
                                        {row && <TeamMark logo={row.teamLogo} color={row.teamColor} />}
                                        <span class="mark-text" data-team>{row?.team ?? ''}</span>
                                    </span>
                                    <span class="g r num" role="cell" data-gap>{row?.gap ?? ''}</span>
                                </div>
                            ))}
                        </div>
                        <a class="door" href={href('live.html')}>
                            <span class="lbl">{h.watchLiveText}</span>
                            <b>{h.watchLive}</b>
                            <span class="arrow" aria-hidden="true">→</span>
                        </a>
                    </div>
                </div>
            </div>

            <div class="band on-ink">
                <div class="wrap band__in">
                    <span class="band__k lbl">{h.upNext}</span>
                    <span class="band__v" data-upnext-name>—</span>
                    <span class="band__v num" data-upnext-when></span>
                    <span class="band__k lbl" data-upnext-in></span>
                    <span class="band__rule" aria-hidden="true"></span>
                    <a class="btn btn--line" href={href(`grandsprix/grandprix.html?gp=${next.id}`)}>{h.timetableLink} <span class="arrow">→</span></a>
                </div>
            </div>
        </section>
    )}

    {last && podium1 && (
        <section class="hero hero--res on-ink" data-hero="result" aria-labelledby="res-title" hidden>
            <div class="wrap">
                <div class="strip lbl">
                    <span class="tag"><span class="sq" style="--c: var(--red)"></span>{h.raceResult}</span>
                    <span>{fill(h.roundOf, { round: last.gp.round, rounds })}</span>
                    <span class="grow">{last.gp.name} — {last.gp.circuit}</span>
                    <span class="num" data-local="date" data-at={last.raceEnd}></span>
                </div>

                <div class="res g12">
                    <p class="res__one" aria-hidden="true">1</p>

                    <div class="res__win">
                        <p class="lbl">{h.winner} · {last.gp.name}</p>
                        <h1 class="res__name cond" id="res-title"><span class="first">{podium1.firstName}</span>{podium1.lastName}</h1>
                        <dl class="res__meta">
                            <div><dt class="lbl">{tb.team}</dt><dd><TeamMark logo={podium1.teamLogo} color={podium1.teamColor} size={22} /><span class="mark-text">{podium1.team}</span></dd></div>
                            <div><dt class="lbl">{h.raceTime}</dt><dd class="num">{podium1.result}</dd></div>
                            {podium1.grid && <div><dt class="lbl">{h.started}</dt><dd class="num">P{podium1.grid}</dd></div>}
                        </dl>
                    </div>

                    <figure class:list={['res__mark', { 'res__mark--photo': winnerPhoto }]}>
                        {winnerPhoto
                            ? <img class="res__photo" src={winnerPhoto.src} width={winnerPhoto.attributes['width']} height={winnerPhoto.attributes['height']} alt="" loading="lazy" decoding="async" />
                            : last.gp.layout && <div class="trk" set:html={last.gp.layout} />}
                        <figcaption class="lbl"><span>{last.gp.circuit}</span><span>R{last.gp.round}</span></figcaption>
                    </figure>

                    <div class="res__pod">
                        {[podium2, podium3].map((row) => row && (
                            <div class="pod">
                                <span class="n">{row.pos}</span>
                                <span class="who">
                                    <b>{row.lastName}</b>
                                    <span class="lbl"><TeamMark logo={row.teamLogo} color={row.teamColor} /><span class="mark-text">{row.team}{row.grid && ` · ${fill(h.fromGrid, { grid: row.grid })}`}</span></span>
                                </span>
                                <span class="gap num">{row.result}{row.fastestLap && <><br /><span class="fl lbl">{tb.fastestLap}</span></>}</span>
                            </div>
                        ))}
                    </div>

                    {rest.length > 0 && (
                        <div class="res__rest">
                            <div class="hd">
                                <h2 class="lbl">{fill(h.positions, { last: 3 + rest.length })}</h2>
                                <a class="lbl" href={href('results.html')}>{h.fullClassification} <span class="arrow">→</span></a>
                            </div>
                            <table class="tbl">
                                <thead class="lbl"><tr><th>{tb.pos}</th><th>{tb.driver}</th><th class="hide-m">{tb.team}</th><th class="r">{tb.gap}</th><th class="r hide-m">{tb.grid}</th><th class="r">{tb.gained}</th></tr></thead>
                                <tbody>
                                    {rest.map((row) => (
                                        <tr>
                                            <td class="p">{row.pos}</td>
                                            <td class="d"><span>{row.firstName}</span>{row.lastName}{row.fastestLap && <span class="fl lbl">{tb.fastestLapShort}</span>}</td>
                                            <td class="hide-m">
                                                <span class="t">
                                                    <TeamMark logo={row.teamLogo} color={row.teamColor} />
                                                    <span class="mark-text">{row.team}</span>
                                                </span>
                                            </td>
                                            <td class="r num">{row.result}</td>
                                            <td class="r hide-m num">{row.grid ? `P${row.grid}` : '—'}</td>
                                            <td class="r num">
                                                {row.gained === null || row.gained === 0
                                                    ? <span class="eq">—</span>
                                                    : row.gained > 0
                                                        ? <span class="gain">▲ {row.gained}</span>
                                                        : <span class="loss">▼ {-row.gained}</span>}
                                            </td>
                                        </tr>
                                    ))}
                                </tbody>
                            </table>
                        </div>
                    )}
                </div>
            </div>

            {next && (
                <div class="band band--paper">
                    <div class="wrap band__in">
                        <span class="band__k lbl">{h.nextRace}</span>
                        <span class="band__v">{next.name}</span>
                        <span class="band__v num" data-next-race-in></span>
                        <span class="band__rule" aria-hidden="true"></span>
                        <a class="btn btn--ink" href={href('results.html')}>{h.allResults} <span class="arrow">→</span></a>
                    </div>
                </div>
            )}
        </section>
    )}

    <script type="application/json" data-hero-state set:html={JSON.stringify(state)} />
</div>

<script>
    import { startHero } from '../../lib/hero-state';
    startHero();
</script>

<style>
    /* ---- Shared ------------------------------------------------------------ */
    .hero {
        position: relative;
        display: flex;
        flex-direction: column;
        min-height: calc(100svh - var(--nav));
        overflow: hidden;
    }
    .hero[hidden] { display: none; }
    .hero:not([hidden]) { animation: wipe .7s ease both; }
    @keyframes wipe {
        from { clip-path: inset(0 100% 0 0); }
        to { clip-path: inset(0); }
    }
    .hero > .wrap { flex: 1; display: flex; flex-direction: column; }

    .strip {
        display: flex;
        flex-wrap: wrap;
        border-bottom: 1px solid currentColor;
    }
    .strip > * { padding: 15px 18px; border-left: 1px solid currentColor; }
    .strip > *:first-child { padding-left: 0; border-left: 0; }
    .strip > .grow { flex: 1; }
    .tag { display: inline-flex; align-items: center; gap: 8px; }

    .trk :global(svg) { width: 100%; height: auto; }

    .digits {
        display: flex;
        align-items: flex-start;
        font-weight: 900;
        font-stretch: 62%;
        line-height: .78;
        letter-spacing: -.01em;
        white-space: nowrap;
    }
    .digits .u { display: flex; flex-direction: column; }
    .digits .u small {
        margin-top: 14px;
        font-size: 11px;
        font-weight: 700;
        font-stretch: 115%;
        letter-spacing: .09em;
        line-height: 1;
        text-transform: uppercase;
    }
    .digits .c { padding: 0 .035em; }

    .band { background: var(--ink); color: #fff; }
    /* Paper band, on the result's ink field (it was red; red is for live) */
    .band--paper { background: var(--paper); color: var(--ink); }
    .band__in {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 14px 28px;
        min-height: 76px;
        padding-top: 12px;
        padding-bottom: 12px;
    }
    .band__k { color: var(--mute-ink); }
    .band--paper .band__k { color: var(--mute); }
    .band__v {
        font-size: 30px;
        font-weight: 900;
        font-stretch: 62%;
        line-height: 1;
        text-transform: uppercase;
    }
    .band__rule { flex: 1; min-width: 24px; height: 1px; background: #3a3a3a; }
    .band--paper .band__rule { background: rgba(18, 18, 18, .3); }

    .ldot--on { background: #fff; animation: beat 1.1s ease-in-out infinite; }
    .ldot--red { background: var(--red); animation: beat 1.1s ease-in-out infinite; }

    /* ---- Upcoming (paper) ---------------------------------------------------- */
    .hero--up { background: var(--paper); color: var(--ink); }
    .up {
        flex: 1;
        grid-template-rows: 1fr auto;
        row-gap: 20px;
        padding: 24px 0 28px;
    }
    .up__head {
        grid-column: 1 / 8;
        grid-row: 1;
        align-self: center;
        display: flex;
        align-items: flex-start;
        gap: 28px;
    }
    .roundel {
        flex: none;
        display: grid;
        place-items: center;
        width: clamp(60px, 8.4vw, 124px);
        aspect-ratio: 1;
        margin-top: .2em;
        border-radius: 50%;
        background: var(--ink);
        color: var(--paper);
        font-size: clamp(30px, 4.6vw, 68px);
        font-weight: 900;
        font-stretch: 62%;
        line-height: 1;
        font-variant-numeric: tabular-nums;
    }
    .up__kicker { margin: 0 0 14px; color: var(--mute); }
    .up__title { margin: 0; font-size: clamp(44px, 7.4vw, 118px); }
    .up__track {
        grid-column: 8 / 13;
        grid-row: 1;
        align-self: center;
        color: var(--red);
    }
    .up__track .trk :global(svg) { max-height: min(36vh, 320px); }
    /* Two by two: length and turns, then laps and the lap record (owner's
       call, 13/10), each pair under a rule */
    .facts {
        display: grid;
        grid-template-columns: 1fr 1fr;
        row-gap: 10px;
        margin-top: 14px;
        color: var(--ink);
    }
    .facts > div { padding: 8px 0 0; border-top: 1px solid var(--ink); }
    .facts > div:nth-child(even) { padding-left: 12px; border-left: 1px solid var(--ink); }
    /* The numbers sit inside a .lbl block: reset its wide letter-spacing */
    .facts b { display: block; font-size: 28px; font-weight: 900; font-stretch: 62%; line-height: 1; letter-spacing: 0; }
    .facts span { display: block; color: var(--mute); }
    /* Who set the lap record and when, on a line of its own */
    .facts__by { margin-top: 2px; }

    .up__count {
        grid-column: 1 / 9;
        grid-row: 2;
        padding-top: 14px;
        border-top: 4px solid var(--ink);
    }
    .up__count[hidden] { display: none; }
    .up__count .head {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 18px;
    }
    .up__count .head b { color: var(--red-ink); }
    /* The digits follow the screen's height too, so a wide but short screen
       (1920 × 1080 minus the browser's bars) fits the whole hero */
    .up__count .digits { font-size: clamp(68px, min(12vw, 17vh), 190px); }
    .up__count .digits .c { color: var(--red); }
    .up__wait { container-type: inline-size; }
    .up__wait p { margin: 0; }
    /* Always on one line (owner's call, 13/10), in any language: the size
       comes from the column's width (cqi) and the title's length (--chars,
       set in the markup), at ~0.46 em per letter in this condensed face,
       up to 110 px. */
    .up__wait-title {
        margin: 10px 0 0 !important;
        font-size: min(110px, 12vh, calc(100cqi / (var(--chars, 18) * .46)));
        white-space: nowrap;
