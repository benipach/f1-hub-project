---
// One season's form, race by race: where the car started (dashed gray) and
// where it finished (white), as in the poster profile's form curve, on the
// new look. P1–P3 is a faint band; the dashed line is that season's points
// cut (lib/driver.ts pointsTo: 6 to 2002, 8 to 2009, 10 since); a win is a
// red dot, a retirement a red × where it was classified. The lines never
// break: a retirement takes the finish line to its ×, a missed race is stepped
// over, the rounds to come end it.
//
// Two drawings of the same chart: a wide one and, on a phone, a taller one,
// so the text doesn't shrink. Hovering a race shows its card (our own, never
// the browser's title): the race around him and the championship after it,
// two ahead and two behind (SliceData); the script is shared by every chart.
import type { DriverRound, DriverSeason } from '../../lib/driver';
import { useI18n } from '../../i18n';
import { href } from '../../lib/paths';
import { curvePath } from '../../lib/curve';
import SliceData from './SliceData.astro';
import '../../styles/chart.css';

interface Props {
    season: DriverSeason;
}

const { season: s } = Astro.props;
const { t, fill, intl } = useI18n(Astro.currentLocale);
const w = t.driverSeason;
const num = new Intl.NumberFormat(intl);
const rs = s.rounds;
const field = Math.max(0, ...rs.map((r) => r.field)) || 20;
const pointsTo = s.pointsTo || 10;

function draw(compact: boolean) {
    const [W, H, padL, padB] = compact ? [400, 300, 30, 22] : [1000, 300, 40, 26];
    const every = compact && rs.length > 14 ? 2 : 1;
    const step = (W - padL) / rs.length;
    const x = (i: number) => padL + (i + 0.5) * step;
    const y = (p: number) => 10 + ((p - 1) / Math.max(1, field - 1)) * (H - padB - 20);
    const outPos = (r: DriverRound) => r.pos ?? field;
    const line = (key: 'pos' | 'grid') => {
        const runs: [number, number][][] = [[]];
        rs.forEach((r, i) => {
            if (r.upcoming) { if (runs.at(-1)!.length) runs.push([]); return; }
            if (r.missed) return;
            const v = key === 'pos' ? (r.out ? outPos(r) : r.pos) : r.grid;
            if (v == null) return;
            runs.at(-1)!.push([x(i), y(v)]);
        });
        return runs.filter((run) => run.length).map((run) => curvePath(run)).join('');
    };
    const ticks = [1, 3, pointsTo, field].filter((v, i, a) => a.indexOf(v) === i && v <= field);
    return { W, H, padL, padB, every, step, x, y, outPos, finish: line('pos'), grid: line('grid'), ticks };
}

// The hover card's head, written at build time (owner, 22/11: as the milestones'
// cards): "Round 7 · 7 Jun", then the flag and the Grand Prix; the race itself is
// in the card's table (places from the grid, points), the sprint in a line
const dayFmt = new Intl.DateTimeFormat(intl, { day: 'numeric', month: 'short', timeZone: 'UTC' });
const day = (iso: string) => dayFmt.format(new Date(`${iso}T12:00:00Z`)).replace('.', '');
const tipOf = (r: DriverRound) => {
    const sp = r.sprint;
    return {
        a: fill(t.driverJourney.round, { n: r.round, date: day(r.date) }),
        b: r.gp,
        f: r.iso ? href(`img/flags/${r.iso.toLowerCase()}.svg`) : '',
        d: sp ? `${w.cols.sprint} · ${sp.grid ? `P${sp.grid}` : '—'} → ${sp.out ?? `P${sp.pos}`}${sp.pts ? ` · ${fill(w.ptsN, { n: num.format(sp.pts) })}` : ''}` : '',
    };
};
const tips = rs.map((r) => (r.upcoming || r.missed ? null : tipOf(r)));
const charts = [draw(false), draw(true)];
---

<div class="fc">
    <p class="col-h">
        <span>{w.form}</span>
        <span class="fc__key">
            <span><i class="fc__sw"></i>{w.finish}</span>
            <span><i class="fc__sw fc__sw--grid"></i>{w.grid}</span>
            <span class="fc__key-out"><svg viewBox="0 0 10 10" aria-hidden="true"><path d="M1 1L9 9M9 1L1 9" /></svg>{w.retired}</span>
        </span>
    </p>
    <div class="fc__plot">
        {charts.map((c, k) => (
            <svg class:list={['fc__svg', k ? 'fc__svg--compact' : 'fc__svg--wide']} viewBox={`0 0 ${c.W} ${c.H}`} role="img" aria-label={`${w.chart} · ${s.year}`}>
                <rect x={c.padL} y={c.y(1) - 7} width={c.W - c.padL} height={c.y(3) - c.y(1) + 14} class="fc__band" />
                <line x1={c.padL} x2={c.W} y1={c.y(pointsTo + 0.5)} y2={c.y(pointsTo + 0.5)} class="fc__pts" />
                <text x={c.W} y={c.y(pointsTo + 0.5) - 6} text-anchor="end" class="fc__lab">{w.pointsLine}</text>
                {c.ticks.map((v) => <text x="0" y={c.y(v) + 4} class="fc__lab">P{v}</text>)}
                <path d={c.grid} class="fc__grid" />
                <path d={c.finish} class="fc__fin" />
                {rs.map((r, i) => (
                    <>
                        {i % c.every === 0 && <text x={c.x(i)} y={c.H - 6} text-anchor="middle" class:list={['fc__lab', { 'fc__lab--dim': r.upcoming || r.missed }]}>{r.round}</text>}
                        {!r.upcoming && !r.missed && r.grid && <circle cx={c.x(i)} cy={c.y(r.grid)} r="3.5" class="fc__g" />}
                        {!r.upcoming && !r.missed && r.out && <><circle cx={c.x(i)} cy={c.y(c.outPos(r))} r="4.5" class="fc__f" data-k={i} /><path d={`M${c.x(i) - 3} ${c.y(c.outPos(r)) - 3}l6 6m0 -6l-6 6`} class="fc__x" /></>}
                        {!r.upcoming && !r.missed && !r.out && r.pos && <circle cx={c.x(i)} cy={c.y(r.pos)} r="4.5" class:list={['fc__f', { 'fc__f--win': r.pos === 1 }]} data-k={i} />}
                    </>
                ))}
                {tips.map((tip, i) => tip && (
                    <rect class="fc__hit" x={c.x(i) - c.step / 2} y="0" width={c.step} height={c.H - c.padB}
                        data-k={i} data-a={tip.a} data-b={tip.b} data-f={tip.f} data-d={tip.d} />
                ))}
            </svg>
        ))}
        <SliceData tables={Object.fromEntries(rs.flatMap((r, i) => (r.race.length ? [[i, [r.race, r.champ]]] : [])))} heads={[w.sliceRace, w.sliceChamp]} moves={[true, true]} />
        <div class="fc__tip"><span class="fc__tip-a"></span><b class="fc__tip-b"></b><span class="fc__tip-c"></span><span class="fc__tip-d"></span><span class="fc__tip-t"></span></div>
    </div>
</div>

<script>
    import '../../lib/chart-tip';
</script>
