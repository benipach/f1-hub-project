---
// One season's form, race by race: where the car started (dashed gray) and
// where it finished (white), as in the poster profile's form curve, on the
// new look. P1–P3 is a faint band; the dashed line is that season's points
// cut (lib/driver.ts pointsTo: 6 to 2002, 8 to 2009, 10 since); a win is a
// red dot, a retirement a red × where it was classified. The lines never
// break: a retirement takes the finish line to its ×, a missed race is stepped
// over, the rounds to come end it.
//
// Two drawings of the same chart: a wide one and, on a phone, a taller one,
// so the text doesn't shrink. Hovering a race shows its card (our own, never
// the browser's title); the script is shared by every chart on the page.
import type { DriverRound, DriverSeason } from '../../lib/driver';
import { useI18n } from '../../i18n';

interface Props {
    season: DriverSeason;
}

const { season: s } = Astro.props;
const { t, fill, plural, intl } = useI18n(Astro.currentLocale);
const w = t.driverSeason;
const num = new Intl.NumberFormat(intl);
const rs = s.rounds;
const field = Math.max(0, ...rs.map((r) => r.field)) || 20;
const pointsTo = s.pointsTo || 10;

function draw(compact: boolean) {
    const [W, H, padL, padB] = compact ? [400, 300, 30, 22] : [1000, 300, 40, 26];
    const every = compact && rs.length > 14 ? 2 : 1;
    const step = (W - padL) / rs.length;
    const x = (i: number) => padL + (i + 0.5) * step;
    const y = (p: number) => 10 + ((p - 1) / Math.max(1, field - 1)) * (H - padB - 20);
    const outPos = (r: DriverRound) => r.pos ?? field;
    // A gentle curve through every point (owner, 20/11: "apenitas curvatura"):
    // monotone cubic (Fritsch–Carlson), so it never swings past a point (no
    // place above P1, no place that didn't happen), with its tangents eased
    // to 60 % so the bends stay slight
    const EASE = 0.6;
    const f = (v: number) => v.toFixed(1);
    const path = (pts: [number, number][]) => {
        if (pts.length < 3) return pts.map(([px, py], i) => `${i ? 'L' : 'M'}${f(px)} ${f(py)}`).join('');
        const d = pts.slice(1).map(([px, py], i) => (py - pts[i]![1]) / (px - pts[i]![0]));
        const m = pts.map((_, i) => (i === 0 ? d[0]! : i === pts.length - 1 ? d.at(-1)! : d[i - 1]! * d[i]! <= 0 ? 0 : (d[i - 1]! + d[i]!) / 2));
        for (let i = 0; i < d.length; i++) {
            if (d[i] === 0) { m[i] = 0; m[i + 1] = 0; continue; }
            const a = m[i]! / d[i]!, b = m[i + 1]! / d[i]!, s = a * a + b * b;
            if (s > 9) { const k = 3 / Math.sqrt(s); m[i] = k * a * d[i]!; m[i + 1] = k * b * d[i]!; }
        }
        let out = `M${f(pts[0]![0])} ${f(pts[0]![1])}`;
        for (let i = 0; i < pts.length - 1; i++) {
            const [x0, y0] = pts[i]!, [x1, y1] = pts[i + 1]!, h = (x1 - x0) / 3;
            out += `C${f(x0 + h)} ${f(y0 + EASE * m[i]! * h)} ${f(x1 - h)} ${f(y1 - EASE * m[i + 1]! * h)} ${f(x1)} ${f(y1)}`;
        }
        return out;
    };
    const line = (key: 'pos' | 'grid') => {
        const runs: [number, number][][] = [[]];
        rs.forEach((r, i) => {
            if (r.upcoming) { if (runs.at(-1)!.length) runs.push([]); return; }
            if (r.missed) return;
            const v = key === 'pos' ? (r.out ? outPos(r) : r.pos) : r.grid;
            if (v == null) return;
            runs.at(-1)!.push([x(i), y(v)]);
        });
        return runs.filter((run) => run.length).map(path).join('');
    };
    const ticks = [1, 3, pointsTo, field].filter((v, i, a) => a.indexOf(v) === i && v <= field);
    return { W, H, padL, padB, every, step, x, y, outPos, finish: line('pos'), grid: line('grid'), ticks };
}

// The hover card's lines, written at build time
const tipOf = (r: DriverRound) => {
    const d = !r.out && r.grid && r.pos ? r.grid - r.pos : null;
    const places = r.out ? (r.pos ? fill(w.classified, { n: r.pos }) : '') : d === null ? '' : d > 0 ? plural(w.up, d) : d < 0 ? plural(w.down, -d) : w.same;
    const sp = r.sprint;
    return {
        a: `R${r.round} · ${r.short}`,
        b: `${r.grid ? `P${r.grid}` : '—'} → ${r.out ?? `P${r.pos}`}`,
        c: [places, r.racePts ? fill(w.ptsN, { n: num.format(r.racePts) }) : w.noPoints].filter(Boolean).join(' · '),
        d: sp ? `${w.cols.sprint} · ${sp.grid ? `P${sp.grid}` : '—'} → ${sp.out ?? `P${sp.pos}`}${sp.pts ? ` · ${fill(w.ptsN, { n: num.format(sp.pts) })}` : ''}` : '',
        dir: d === null ? (r.out ? 'out' : '') : d > 0 ? 'up' : d < 0 ? 'down' : '',
    };
};
const tips = rs.map((r) => (r.upcoming || r.missed ? null : tipOf(r)));
const charts = [draw(false), draw(true)];
---

<div class="fc">
    <p class="col-h">
        <span>{w.form}</span>
        <span class="fc__key">
            <span><i class="fc__sw"></i>{w.finish}</span>
            <span><i class="fc__sw fc__sw--grid"></i>{w.grid}</span>
            <span class="fc__key-out"><svg viewBox="0 0 10 10" aria-hidden="true"><path d="M1 1L9 9M9 1L1 9" /></svg>{w.retired}</span>
        </span>
    </p>
    <div class="fc__plot">
        {charts.map((c, k) => (
            <svg class:list={['fc__svg', k ? 'fc__svg--compact' : 'fc__svg--wide']} viewBox={`0 0 ${c.W} ${c.H}`} role="img" aria-label={`${w.chart} · ${s.year}`}>
                <rect x={c.padL} y={c.y(1) - 7} width={c.W - c.padL} height={c.y(3) - c.y(1) + 14} class="fc__band" />
                <line x1={c.padL} x2={c.W} y1={c.y(pointsTo + 0.5)} y2={c.y(pointsTo + 0.5)} class="fc__pts" />
                <text x={c.W} y={c.y(pointsTo + 0.5) - 6} text-anchor="end" class="fc__lab">{w.pointsLine}</text>
                {c.ticks.map((v) => <text x="0" y={c.y(v) + 4} class="fc__lab">P{v}</text>)}
                <path d={c.grid} class="fc__grid" />
                <path d={c.finish} class="fc__fin" />
                {rs.map((r, i) => (
                    <>
                        {i % c.every === 0 && <text x={c.x(i)} y={c.H - 6} text-anchor="middle" class:list={['fc__lab', { 'fc__lab--dim': r.upcoming || r.missed }]}>{r.round}</text>}
                        {!r.upcoming && !r.missed && r.grid && <circle cx={c.x(i)} cy={c.y(r.grid)} r="3.5" class="fc__g" />}
                        {!r.upcoming && !r.missed && r.out && <><circle cx={c.x(i)} cy={c.y(c.outPos(r))} r="4.5" class="fc__f" /><path d={`M${c.x(i) - 3} ${c.y(c.outPos(r)) - 3}l6 6m0 -6l-6 6`} class="fc__x" /></>}
                        {!r.upcoming && !r.missed && !r.out && r.pos && <circle cx={c.x(i)} cy={c.y(r.pos)} r="4.5" class:list={['fc__f', { 'fc__f--win': r.pos === 1 }]} />}
                    </>
                ))}
                {tips.map((tip, i) => tip && (
                    <rect class="fc__hit" x={c.x(i) - c.step / 2} y="0" width={c.step} height={c.H - c.padB}
                        data-a={tip.a} data-b={tip.b} data-c={tip.c} data-d={tip.d} data-dir={tip.dir} />
                ))}
            </svg>
        ))}
        <div class="fc__tip" hidden><span class="fc__tip-a"></span><b class="fc__tip-b"></b><span class="fc__tip-c"></span><span class="fc__tip-d"></span></div>
    </div>
</div>

<script>
    // The race card on the form chart: follows the hovered race, inside its plot
    document.addEventListener('pointerover', (e) => {
        const hit = (e.target as Element).closest?.('.fc__hit') as SVGRectElement | null;
        const plot = (e.target as Element).closest?.('.fc__plot') as HTMLElement | null;
        if (!plot) return;
        const tip = plot.querySelector<HTMLElement>('.fc__tip')!;
        if (!hit) { tip.hidden = true; return; }
        for (const k of ['a', 'b', 'c', 'd'] as const) tip.querySelector<HTMLElement>(`.fc__tip-${k}`)!.textContent = hit.dataset[k] ?? '';
        tip.dataset.dir = hit.dataset.dir ?? '';
        tip.hidden = false;
        const box = plot.getBoundingClientRect(), r = hit.getBoundingClientRect();
        const left = Math.min(Math.max(r.left + r.width / 2 - box.left - tip.offsetWidth / 2, 0), box.width - tip.offsetWidth);
        tip.style.left = `${left}px`;
    });
    document.addEventListener('pointerleave', () => document.querySelectorAll<HTMLElement>('.fc__tip').forEach((tip) => (tip.hidden = true)), true);
</script>
