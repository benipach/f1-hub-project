---
// A driver's profile (_design/DESIGN.md, "Driver profile"), in the page's
// language: rendered by pages/driver-preview/[id].astro (English) and
// pages/[lang]/driver-preview/[id].astro. One page per driver in
// careers.json, built from lib/driver.ts.
//
// The build writes the whole page. The browser script at the bottom only
// redraws the season panel (season picker, "Season by season") and the
// all-time board (its tabs) with the same functions (lib/driver-view.ts),
// and runs the hovers: race cards, the ribbon's cards, milestones in the grid.
import { getImage } from 'astro:assets';
import '../../styles/driver.css';
import TeamMark from '../TeamMark.astro';
import Base from '../../layouts/Base.astro';
import { DATA_DIR } from '../../lib/data';
import { BOARD_STATS, buildDriver, type DriverSeason } from '../../lib/driver';
import { DRIVER_FACTS } from '../../lib/driver-facts';
import { boardHtml, esc, flagHtml, fmt, logoHtml, ord, plural, seasonHtml, type DriverView } from '../../lib/driver-view';
import { href } from '../../lib/paths';
import { useI18n, fill } from '../../i18n';

interface Props {
    id: string;
}

const { id } = Astro.props;
const { locale, t, intl } = useI18n(Astro.currentLocale);
const T_ = t.driver;
const D = buildDriver(DATA_DIR, id, locale);
const P = DRIVER_FACTS[id] ?? {};
const T = D.totals;
const lastEra = D.eras.at(-1)!;
const S = D.seasons;

// Team logos, resized as TeamMark does (twice the biggest box used, 24 px),
// for the parts drawn as HTML strings
const logoFiles = import.meta.glob<{ default: ImageMetadata }>('../../../../img/teams/*-logo.png', { eager: true });
const logos: Record<string, string> = {};
for (const team of [...D.eras, ...S.flatMap((s) => s.teams)]) {
    const source = team.logo ? logoFiles[`../../../../${team.logo}`]?.default : undefined;
    if (!source || logos[team.id]) continue;
    const image = await getImage({ src: source, format: 'webp', quality: 80, ...(source.width >= source.height ? { width: 48 } : { height: 48 }) });
    logos[team.id] = image.src;
}
const view: DriverView = { intl, lang: locale, w: { season: T_.season, stats: T_.stats }, logos, flags: href('img/flags/') };
const n = (v: number) => fmt(view, v);
const span = (a: number, b: number) => (a === b ? `${a}` : `${a}–${b}`);
const date = (iso: string) => new Date(iso).toLocaleDateString(intl, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
// Age on the day the page is built (the site is built after every session)
const ageAt = (born: string, ref?: string) => {
    const b = new Date(born), r = ref ? new Date(ref) : new Date();
    let a = r.getUTCFullYear() - b.getUTCFullYear();
    if (r.getUTCMonth() < b.getUTCMonth() || (r.getUTCMonth() === b.getUTCMonth() && r.getUTCDate() < b.getUTCDate())) a--;
    return a;
};
const yy = (y: number, many: boolean) => (many ? `’${String(y).slice(2)}` : `${y}`);
// A section title's longest word, so on a phone its size stays where that
// word fits ("TEMPORADA 1990 ⌄" overflowed 375 px; driver.css, ≤ 760 px)
const lenOf = (title: string) => `--len: ${Math.max(...title.split(' ').map((w) => w.length))}`;

// The photo: the hero winner's treatment, resized at build time
const photos = import.meta.glob<{ default: ImageMetadata }>('../../../../img/drivers/*-2.png', { eager: true });
const photoSource = D.photo ? photos[`../../../../${D.photo}`]?.default : undefined;
const photo = photoSource ? await getImage({ src: photoSource, format: 'webp', width: 1000, quality: 60 }) : null;

// ---- 1. Hero: up to five figures, the ones that aren't zero first --------
const figs = [
    T.titles && { v: n(T.titles), l: plural(view, T_.figs.titles, T.titles), note: T.titleYears.join(' · '), red: true },
    T.wins && { v: n(T.wins), l: plural(view, T_.figs.wins, T.wins) },
    T.podiums && { v: n(T.podiums), l: plural(view, T_.figs.podiums, T.podiums) },
    T.poles && { v: n(T.poles), l: plural(view, T_.figs.poles, T.poles) },
    T.fastestLaps && { v: n(T.fastestLaps), l: plural(view, T_.figs.fastestLaps, T.fastestLaps) },
    T.points && { v: n(T.points), l: T_.figs.points },
    { v: n(T.races), l: plural(view, T_.figs.races, T.races) },
    { v: n(T.seasons), l: plural(view, T_.figs.seasons, T.seasons) },
].filter((f): f is { v: string; l: string; note?: string; red?: boolean } => Boolean(f)).slice(0, 5);
const status = D.active ? null : D.died && D.born ? `${new Date(D.born).getUTCFullYear()}–${new Date(D.died).getUTCFullYear()}` : fill(T_.lastRaced, { year: S.at(-1)!.year });

// ---- 2. Driver info -------------------------------------------------------
const I = T_.info;
const age = D.born ? (D.died ? fill(I.diedAged, { n: ageAt(D.born, D.died) }) : fill(I.yearsOld, { n: ageAt(D.born) })) : null;
const debutMs = D.milestones.find((m) => m.label === 'Debut');

// ---- 3. One season: the active one, or the best finished -------------------
const best = [...S].filter((s) => s.done).sort((a, b) => (a.pos ?? 99) - (b.pos ?? 99) || b.wins - a.wins || b.year - a.year)[0];
const first: DriverSeason = D.active || !best ? S.at(-1)! : best;

// ---- 4. Season by season --------------------------------------------------
const heightOf = (pos: number | null) => (pos ? Math.max(5, 100 - (pos - 1) * 4.6) : 0);
const many = S.length > 12;

// ---- 5. Career stats -------------------------------------------------------
const STATS = BOARD_STATS.map((k) => [k, T_.stats[k]] as const);

// ---- 6. Career journey ----------------------------------------------------
const J = T_.journey;
const years: number[] = [];
for (let y = S[0]!.year; y <= S.at(-1)!.year; y++) years.push(y);
const byYear = new Map(S.map((s) => [s.year, s]));
const longRibbon = years.length > 14;
// On a phone a long ribbon labels one year in five, the first and the last
// (driver.css); a fifth year too close to either end would touch it
const keepYear = (y: number, i: number) => i === 0 || i === years.length - 1 || (y % 5 === 0 && i >= 3 && i <= years.length - 4);
// The card over a stretch on hover (owner, 29/10): year, team and the races
// run with it out of the season's ("Aston Martin 22/22"). Its HTML goes to
// the browser script, by index.
const ribTips: string[] = [];
const ribTip = (html: string) => ribTips.push(html) - 1;
// `label`: the card's words as plain text, for screen readers (the card itself
// only shows on hover)
type Stretch = { k: string; n: number; tip: number; color: string | null; label: string };
const ribbon = years.map((y) => {
    const s = byYear.get(y);
    if (!s) return { y, gap: true as const, tip: ribTip(`<span class="lbl mute">${y}</span><b class="rtip__name cond">${esc(J.noRaces)}</b>`), label: `${y} · ${J.noRaces}` };
    const runs: { k: string; n: number }[] = [];
    for (const r of s.rounds) {
        const k = r.upcoming ? 'tbd' : r.missed ? 'off' : r.team!;
        const last = runs.at(-1);
        if (last && last.k === k) last.n++;
        else runs.push({ k, n: 1 });
    }
    // Races per team in the year, all its stretches together
    const of = s.rounds.length;
    const byTeam = new Map<string, number>();
    for (const { k, n: c } of runs) byTeam.set(k, (byTeam.get(k) ?? 0) + c);
    const stretches: Stretch[] = runs.map(({ k, n: c }) => {
        const team = s.teams.find((x) => x.id === k);
        const total = byTeam.get(k)!;
        const head = `<span class="lbl mute">${y}</span>`;
        const tip = ribTip(k === 'tbd'
            ? `${head}<b class="rtip__name cond">${esc(J.toCome)}</b><span class="rtip__n cond">${total}<span> ${esc(plural(view, J.left, total))}</span></span>`
            : k === 'off'
            ? `${head}<b class="rtip__name cond">${esc(J.didNotRace)}</b><span class="rtip__n cond">${total}<span>/${of}</span></span>`
            : `${head}<span class="rtip__team">${logoHtml(view, team, 22)}<b class="rtip__name cond">${esc(team?.name ?? '')}</b></span><span class="rtip__n cond">${total}<span>/${of}</span></span><span class="lbl mute">${esc(plural(view, J.racesWord, total))}</span>`);
        const label = k === 'tbd' ? `${y} · ${J.toCome} · ${total} ${plural(view, J.left, total)}`
            : k === 'off' ? `${y} · ${J.didNotRace} · ${total}/${of}`
            : `${y} · ${team?.name ?? ''} · ${total}/${of} ${plural(view, J.racesWord, total)}`;
        return { k, n: c, tip, color: k === 'tbd' || k === 'off' ? null : team?.color ?? '#8a857b', label };
    });
    return { y, gap: false as const, stretches, champion: s.champion };
});

// Milestones by race: "<year>|<round>" → labels
const LABELS: Record<string, keyof typeof T_.labels> = {
    'Debut': 'debut', 'First points': 'firstPoints', 'First podium': 'firstPodium', 'First win': 'firstWin', 'First pole': 'firstPole',
    'Last win': 'lastWin', 'Longest winning streak': 'streak', 'Broke all-time record': 'broke', 'Equalled all-time record': 'equalled',
    'Best result in the team': 'bestInTeam', 'First win with the team': 'firstWithTeam', 'Last win with the team': 'lastWithTeam',
};
const labelOf = (label: string) => {
    const title = /^(\d+)\w* World Title$/.exec(label);
    if (title) return fill(T_.labels.title, { ordinal: ord(view, Number(title[1])) });
    const key = LABELS[label];
    return key ? T_.labels[key] : label;
};
const msKey = (year: number, round: number | null) => `${year}|${round ?? ''}`;
const ms = new Map<string, string[]>();
for (const m of D.milestones) if (m.round) ms.set(msKey(m.year, m.round), [...(ms.get(msKey(m.year, m.round)) ?? []), labelOf(m.label)]);
const cols = Math.max(...S.map((s) => s.rounds.length));
const cellOf = (s: DriverSeason, r: DriverSeason['rounds'][number]) => {
    if (r.upcoming) return { cls: 'tbd', txt: '', tt: fill(J.cellToCome, { round: r.round, gp: r.gp }), key: '' };
    if (r.missed) return { cls: 'miss', txt: '', tt: fill(J.cellMissed, { round: r.round, gp: r.gp }), key: '' };
    const key = msKey(s.year, r.round);
    const m = ms.get(key);
    const cls = r.out ? 'out' : r.pos === 1 ? 'win' : r.pos && r.pos <= 3 ? 'pod' : r.pts > 0 ? 'pts' : 'nop';
    // DNS and DSQ in full: cut to two letters ("DN", "DS") they read as nothing
    const txt = r.out ? (r.out === 'DNF' ? '×' : r.out) : String(r.pos ?? '');
    const result = r.out ?? `P${r.pos}`;
    const tt = fill(J.cell, { round: r.round, gp: r.gp, result: r.grid ? fill(J.from, { result, grid: r.grid }) : result, pts: n(r.pts) }) + (m ? ` · ${m.join(', ')}` : '');
    return { cls: `${cls} ${m ? 'ms' : ''}`, txt, tt, key: m ? key : '' };
};
const milestones = [...D.milestones].sort((a, b) => a.date.localeCompare(b.date));

// What the browser script redraws with
const payload = { view, D: { id: D.id, first: D.first, last: D.last, totals: D.totals, ranks: D.ranks, boards: D.boards, seasons: S }, ribTips };
---

<Base
    title={fill(T_.meta, { name: `${D.first} ${D.last}` })}
    description={fill(T_.description, { name: `${D.first} ${D.last}`, races: T.races, wins: T.wins, podiums: T.podiums })}
    current="drivers"
    noindex
>
    <svg class="defs" width="0" height="0" aria-hidden="true"><filter id="duo" color-interpolation-filters="sRGB">
        <feColorMatrix type="matrix" values=".2126 .7152 .0722 0 0  .2126 .7152 .0722 0 0  .2126 .7152 .0722 0 0  0 0 0 1 0" />
        <feComponentTransfer>
            <feFuncR type="table" tableValues=".0706 .9373" />
            <feFuncG type="table" tableValues=".0706 .9176" />
            <feFuncB type="table" tableValues=".0706 .8784" />
        </feComponentTransfer>
    </filter></svg>

    <div id="page">
        <!-- 1. Hero -->
        <section class="hero f-ink on-ink wipe-in">
            <div class="wrap">
                <div class="strip lbl">
                    <span>{T_.driver}</span>
                    {D.nationality && <span>{D.nationality}</span>}
                    <span><TeamMark logo={lastEra.logo} color={lastEra.color} size={20} /> {lastEra.name}{D.active ? '' : ` · ${fill(T_.until, { year: lastEra.to })}`}</span>
                    {D.active ? <span class="live">{T_.onTheGrid}</span> : <span class="mute">{status}</span>}
                    {/* No code (most drivers before 2014): no empty box at the strip's end */}
                    {D.code && <span>{D.code}</span>}
                </div>
                <div class="hero__body">
                    <div>
                        <p class="hero__first">{D.first}</p>
                        <h1 class="hero__last cond"><span data-fit>{D.last}</span></h1>
                        <div class="hero__num"><b class="cond">#{D.number}</b><span class="lbl mute">{D.active ? T_.raceNumber : T_.lastRaceNumber}{D.code && <><br />{D.code}</>}</span></div>
                    </div>
                    {photo
                        ? <div class="photo"><img src={photo.src} width={photo.attributes['width']} height={photo.attributes['height']} alt={`${D.first} ${D.last}`} decoding="async" /></div>
                        : <div class="photo photo--none"><b class="cond">{D.number}</b></div>}
                </div>
                <div class="figs" style={`--n: ${figs.length}`}>
                    {figs.map((f) => (
                        <div class="fig"><b class:list={['cond', { red: f.red }]}>{f.v}</b><span class="lbl">{f.l}</span>{f.note && <span class="lbl note">{f.note}</span>}</div>
                    ))}
                </div>
            </div>
        </section>

        <!-- 2. Driver info: a spec sheet -->
        <section class="sec f-paper">
            <div class="wrap">
                <div class="sec__head"><div><p class="sec__kick lbl">{I.kick}</p><h2 class="sec__title cond" style={lenOf(I.title)}>{I.title}</h2></div></div>
                <div class="info">
                    <div class="cell cell--2"><span class="lbl">{I.fullName}</span><span class="cell__v cond">{P.fullName ?? `${D.first} ${D.last}`}</span></div>
                    <div class="cell"><span class="lbl">{I.born}</span><span class="cell__v cond">{D.born ? date(D.born) : '—'}</span>{P.birthplace && <span class="cell__s lbl mute">{P.birthplace}</span>}</div>
                    <div class="cell">
                        <span class="lbl">{D.died ? I.died : I.age}</span>
                        <span class="cell__v cond">{D.died ? date(D.died) : age ?? '—'}</span>
                        {D.died
                            ? <span class="cell__s lbl mute">{age}{P.deathPlace && ` · ${P.deathPlace}`}</span>
                            : D.born && <span class="cell__s lbl mute">{fill(I.atDebut, { n: ageAt(D.born, D.debut) })}</span>}
                    </div>
                    <div class="cell">
                        <span class="lbl">{I.nationality}</span>
                        <span class="cell__v cond nat"><Fragment set:html={flagHtml(view, D.iso)} />{D.nationality ?? '—'}</span>
                        {/* Home races are the latest calendar's: only a driver on the grid races them */}
                        {D.nationality && D.active && <span class="cell__s lbl mute" data-tt={D.homeRaces.join(' · ')}>{D.homeRaces.length ? plural(view, I.homeRaces, D.homeRaces.length, { year: D.latest }) : fill(I.noHomeRaces, { year: D.latest })}</span>}
                    </div>
                    <div class="cell"><span class="lbl">{I.number}</span><span class="cell__v cond">#{D.number}</span><span class="cell__s lbl mute" data-tt={D.numbers.map((x) => `#${x}`).join(' · ')}>{D.numbers.length <= 1 ? I.onlyNumber : fill(I.numbers, { n: D.numbers.length })}</span></div>
                    <div class="cell"><span class="lbl">{I.debut}</span><span class="cell__v cond">{date(D.debut)}</span><span class="cell__s lbl mute">{debutMs ? `${debutMs.gp} · ${D.eras[0]!.name}` : D.eras[0]!.name}</span></div>
                    <div class="cell"><span class="lbl">{I.seasons}</span><span class="cell__v cond">{T.seasons}</span><span class="cell__s lbl mute">{span(S[0]!.year, S.at(-1)!.year)} · {plural(view, I.races, T.races, { n: n(T.races) })}</span></div>
                    <div class="cell cell--4">
                        <span class="lbl">{D.eras.length === 1 ? I.team : fill(I.teams, { n: new Set(D.eras.map((e) => e.id)).size })}</span>
                        <table class="teams">
                            <thead class="lbl mute"><tr><th>{I.team}</th><th>{I.years}</th><th class="n">{T_.figs.races.other}</th><th class="n">{I.wins}</th><th class="n">{I.podiums}</th><th class="n">{I.points}</th><th class="n">{I.best}</th></tr></thead>
                            <tbody>
                                {D.eras.map((e) => (
                                    <tr class:list={{ champ: e.titles.length }}>
                                        <td><span class="tm"><TeamMark logo={e.logo} color={e.color} size={22} /><b class="cond">{e.name}</b>{e.titles.length > 0 && <span class="tag lbl">{fill(I.champion, { years: e.titles.join(', ') })}</span>}</span></td>
                                        <td class="yr cond">{span(e.from, e.to)}</td>
                                        <td class="n cond">{e.races}</td>
                                        <td class="n cond">{e.wins || '·'}</td>
                                        <td class="n cond">{e.podiums || '·'}</td>
                                        <td class="n cond">{n(Math.round(e.points))}</td>
                                        <td class="n cond">{e.wins ? 'P1' : e.best ? `P${e.best}` : '—'}</td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                    {(P.junior || P.beyond) && [[I.before, P.junior], [I.beyond, P.beyond]].map(([label, rows]) => (
                        <div class="cell cell--2 cell--rec">
                            <span class="lbl">{label as string}</span>
                            {rows && <ol class="rec">{(rows as readonly (readonly [string, string])[]).map(([y, text]) => <li><span class="rec__y cond">{y}</span><span class="rec__t">{text}</span></li>)}</ol>}
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- 3. One season: racecraft -->
        <section class="sec f-ink on-ink" id="season">
            <div class="wrap">
                <div class="sec__head"><div><p class="sec__kick lbl">{T_.season.kick}</p>
                    {/* One season: just the year, no picker with a single choice */}
                    {S.length === 1 ? <h2 class="sec__title cond picker" style={`--len: ${T_.season.title.length + 5}`}>{T_.season.title} <span class="yp" data-season><span data-value>{first.year}</span></span></h2> :
                    <h2 class="sec__title cond picker" style={`--len: ${T_.season.title.length + 6}`}>{T_.season.title} <span class="yp" data-season>
                        {/* No aria-label: the year it shows is its name ("Season" overrode it) */}
                        <button class="yp__btn" type="button" aria-haspopup="listbox" aria-expanded="false"><span data-value>{first.year}</span><svg class="yp__chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4" /></svg></button>
                        <span class="yp__panel"><span class="yp__list" role="listbox" aria-label={T_.season.title}>{[...S].reverse().map((s) => <span class="yp__opt" role="option" tabindex={-1} data-year={s.year} aria-selected={s.year === first.year ? 'true' : 'false'}>{s.year}</span>)}</span><span class="yp__thumb" aria-hidden="true" hidden><i></i></span></span>
                    </span></h2>}</div></div>
                <div data-one set:html={seasonHtml(view, D, first)} />
            </div>
        </section>

        <!-- 4. Season by season -->
        <section class="sec f-paper">
            <div class="wrap">
                <div class="sec__head"><div><p class="sec__kick lbl">{fill(T_.sbs.kick, { name: D.last })}</p><h2 class="sec__title cond" style={lenOf(T_.sbs.title)}>{T_.sbs.title}</h2></div></div>
                <div class="sbs__wrap"><div class="sbs" style={`--n: ${S.length}`}>
                    <div class="sbs__grid">
                        <div class="sbs__lab lbl">{T_.sbs.championship}</div>
                        {S.map((s) => (
                            <button class:list={['sbs__bars', { in: heightOf(s.pos) >= 16, 'is-title': s.champion, sbs__sel: s.year === first.year }]} type="button" data-y={s.year} style={`--h: ${heightOf(s.pos)}%`} aria-label={fill(T_.sbs.barTip, { year: s.year, pos: s.pos ? ord(view, s.pos) : '—', pts: n(s.pts) }) + (s.champion ? ` · ${T_.sbs.champion}` : '')}>
                                {!s.done && <b class="now lbl">{T_.sbs.now}</b>}<span class="cond">{s.pos ?? '—'}</span><i></i>
                            </button>
                        ))}
                        <div class="sbs__lab lbl">{T_.sbs.team}</div>
                        {S.map((s) => <div class="sbs__row">{s.teams.map((tm) => <TeamMark logo={tm.logo} color={tm.color} size={52} />)}</div>)}
                        <div class="sbs__lab lbl">{T_.sbs.points}</div>
                        {S.map((s) => <div class="sbs__row cond">{n(s.pts)}</div>)}
                        <div class="sbs__lab lbl">{T_.sbs.wins}</div>
                        {S.map((s) => <div class="sbs__row cond">{s.wins || '·'}</div>)}
                        <div class="sbs__lab lbl">{T_.sbs.podiums}</div>
                        {S.map((s) => <div class="sbs__row cond">{s.podiums || '·'}</div>)}
                        <div class="sbs__lab lbl">{T_.sbs.vsMate}</div>
                        {S.map((s) => (
                            <div class="sbs__row cond">
                                {s.mate ? <><span aria-hidden="true" style={s.mate.race[0] >= s.mate.race[1] ? undefined : 'color: var(--red-ink)'}>{s.mate.race[0]}–{s.mate.race[1]}</span><span class="sr">{fill(T_.sbs.mateTip, { a: s.mate.race[0], b: s.mate.race[1], name: `${s.mate.first} ${s.mate.last}` })}</span></> : '·'}
                            </div>
                        ))}
                        <div class="sbs__lab lbl">{T_.sbs.mate}</div>
                        {S.map((s) => <div class="sbs__row cond">{s.mate ? <><span class="sbs__mate" aria-hidden="true" data-y={s.year}>{s.mate.last.slice(0, 3)}<span class="sbs__rest" style={`--n: ${[...s.mate.last.slice(3)].length}`}>{[...s.mate.last.slice(3)].map((c, i) => <span style={`--i: ${i}`}>{c}</span>)}</span></span><span class="sr">{s.mate.first} {s.mate.last}</span></> : '·'}</div>)}
                        <div class="sbs__lab"></div>
                        {S.map((s) => <div class:list={['sbs__row y cond', { sbs__sel: s.year === first.year }]} data-y={s.year}>{yy(s.year, many)}</div>)}
                    </div>
                </div></div>
                <div class="sbs__key lbl mute">
                    <span>{T_.sbs.key} · <i style="background: var(--red); border-radius: 0"></i>{T_.sbs.champion}</span>
                </div>
            </div>
        </section>

        <!-- 5. Career stats -->
        <section class="sec f-ink on-ink">
            <div class="wrap">
                <div class="sec__head"><div><p class="sec__kick lbl">{T_.stats.kick}</p><h2 class="sec__title cond" style={lenOf(T_.stats.title)}>{T_.stats.title}</h2></div></div>
                {T.titles > 0 && (
                    <div class="crown">
                        <p class="crown__n cond">{T.titles}</p>
                        <div class="crown__t">
                            <p class="lbl" style="margin: 0 0 12px">{T.titles === 1 ? T_.stats.champion : fill(T_.stats.champions, { n: T.titles })} · {fill(T_.stats.allTime, { rank: ord(view, D.ranks.titles) })}</p>
                            {S.filter((s) => s.champion).map((s) => (
                                <div><b class="cond">{s.year}</b><span class="lbl"><TeamMark logo={s.teams[0]!.logo} color={s.teams[0]!.color} size={20} /> {s.teams[0]!.name}</span><span class="lbl mute">{fill(T_.stats.titleLine, { pts: n(s.pts), wins: s.wins })}</span></div>
                            ))}
                        </div>
                    </div>
                )}
                <div class="ranks">
                    {STATS.map(([k, label]) => (
                        <div class="rank"><b class="cond">{n(T[k])}</b><span class="lbl">{label}</span>{T[k] > 0 && <span class:list={['pos lbl', { top: D.ranks[k] <= 10 }]}>{fill(T_.stats.allTime, { rank: ord(view, D.ranks[k]) })}</span>}</div>
                    ))}
                </div>
                <div class="boardw">
                    {/* Toggle buttons, one pressed (a tablist needs tab roles and arrow keys) */}
                    <div class="tabs" role="group" aria-label={T_.stats.title}>{STATS.map(([k, label], i) => <button type="button" data-k={k} aria-pressed={i === 0 ? 'true' : 'false'}>{label}</button>)}</div>
                    <ol class="board" data-board set:html={boardHtml(view, D, 'wins')} />
                </div>
            </div>
        </section>

        <!-- 6. Career journey -->
        <section class="sec f-paper">
            <div class="wrap">
                <div class="sec__head"><div><p class="sec__kick lbl">{plural(view, J.seasons, T.seasons)} · {plural(view, J.races, T.races, { n: n(T.races) })} · {plural(view, J.teams, D.eras.length)}</p><h2 class="sec__title cond" style={lenOf(J.title)}>{J.title}</h2></div></div>
                <div class:list={['ribbon', { 'is-long': longRibbon }]} style={`--n: ${years.length}`}>
                    {ribbon.map((y, i) => y.gap
                        ? <div class:list={['ribbon__y is-gap', { keep: keepYear(y.y, i) }]}><div class="ribbon__cells" data-tip={y.tip}><span class="sr">{y.label}</span></div><span class="lbl mute" aria-hidden="true"><span>{yy(y.y, longRibbon)}</span></span></div>
                        : (
                            <div class:list={['ribbon__y', { keep: keepYear(y.y, i) }]}>
                                <div class="ribbon__cells">{y.stretches.map((st) => <i class={st.color ? undefined : st.k} style={st.color ? `--n: ${st.n}; --c: ${st.color}` : `--n: ${st.n}`} data-tip={st.tip}><span class="sr">{st.label}</span></i>)}</div>
                                {/* The year is in each stretch's text already; the red square says it in words */}
                                <span class="lbl"><span aria-hidden="true">{yy(y.y, longRibbon)}</span>{y.champion && <span class="t"><span class="sr">{y.y} · {T_.sbs.champion}</span></span>}</span>
                            </div>
                        ))}
                    <div class="rtip" aria-hidden="true"></div>
                </div>
                <div class="eras lbl">
                    {D.eras.map((e) => <span><TeamMark logo={e.logo} color={e.color} size={18} /> {e.name} <span class="mute">{span(e.from, e.to)} · {plural(view, J.races, e.races)}</span></span>)}
                </div>

                <div class="every">
                    <div class="every__head">
                        <h3 class="cond">{J.every}</h3>
                        <div class="key lbl">
                            <span><i class="c win">1</i>{J.win}</span><span><i class="c pod">2</i>{J.podium}</span><span><i class="c pts">7</i>{J.points}</span><span><i class="c nop">14</i>{J.noPoints}</span><span><i class="c out">×</i>{J.out}</span><span><i class="c miss"></i>{J.missed}</span><span><i class="c ms nop"></i>{J.milestone}</span>
                        </div>
                    </div>
                    <div class="rows" style={`--cols: ${cols}; --mcols: ${Math.ceil(cols / 2)}`}>
                        {S.map((s) => (
                            <div class="row">
                                <div class="row__y"><b class="cond">{s.year}</b>{s.teams.map((tm) => <TeamMark logo={tm.logo} color={tm.color} size={18} />)}</div>
                                <div class="cells">
                                    {s.rounds.map((r, i) => {
                                        const c = cellOf(s, r);
                                        // The visible mark ("3", "×") alone means nothing read
                                        // aloud: the card's words go to screen readers instead
                                        return <span class={`c ${c.cls}`} style={`--k: ${i}`} data-ms={c.key} data-tt={c.tt}><span aria-hidden="true">{c.txt}</span><span class="sr">{c.tt}</span></span>;
                                    })}
                                </div>
                            </div>
                        ))}
                    </div>
                </div>

                {milestones.length > 0 && (
                    <div class="ledger">
                        <div class="every__head"><h3 class="cond">{J.milestones}</h3><span class="lbl mute">{J.hint}</span></div>
                        {/* In the order they happened (owner, 29/10) */}
                        <ol class="ledger__list">
                            {milestones.map((m) => {
                                // A button when it has a race to find in the grid
                                // (keyboard and screen readers reach it); text otherwise
                                const Tag = m.round ? 'button' : 'div';
                                return (
                                    <li data-ms={m.round ? msKey(m.year, m.round) : ''}>
                                        <Tag class="ledger__btn" {...(m.round ? { type: 'button', 'aria-pressed': 'false' } : {})}>
                                            <span class="y cond">{m.year}</span>
                                            <span><b class="cond">{labelOf(m.label)}</b><br /><span class="lbl mute">{m.gp} · {m.team}{m.streak ? ` · ${fill(J.inARow, { n: m.streak })}` : ''}</span></span>
                                            <span class="lbl">{`P${m.pos}`}{m.grid ? <> <span class="mute">{fill(J.fromGrid, { n: m.grid })}</span></> : ''}</span>
                                        </Tag>
                                    </li>
                                );
                            })}
                        </ol>
                    </div>
                )}
            </div>
        </section>
    </div>

    <script type="application/json" id="driver-data" set:html={JSON.stringify(payload).replace(/</g, '\\u003c')} />
</Base>

<script>
    import { boardHtml, fmt, seasonHtml, tipHtml, type DriverView } from '../../lib/driver-view';
    import type { BoardStat, DriverProfile } from '../../lib/driver';

    type Payload = {
        view: DriverView;
        D: Pick<DriverProfile, 'id' | 'first' | 'last' | 'totals' | 'ranks' | 'boards' | 'seasons'>;
        ribTips: string[];
    };
    const { view, D, ribTips } = JSON.parse(document.getElementById('driver-data')!.textContent!) as Payload;
    const main = document.getElementById('page')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ---- Hero: the last name as wide as its column; the figures one size ----
    function fitName() {
        const el = main.querySelector<HTMLElement>('[data-fit]');
        if (!el) return;
        el.style.display = 'inline-block';
        el.style.whiteSpace = 'nowrap';
        el.style.fontSize = '100px';
        // As wide as its column, up to 300 px, and at most 28 % of the screen's
        // height so the hero fits the first screen (owner, 29/10)
        el.style.fontSize = `${Math.min(300, Math.floor(innerHeight * 0.28), Math.floor((100 * el.parentElement!.clientWidth) / el.getBoundingClientRect().width))}px`;
        el.style.display = 'block';
    }
    // One size for all the figures, the biggest that lets the widest one fit
    // its column, up to 132 px (owner, 18/10)
    function fitFigs() {
        const nums = [...main.querySelectorAll<HTMLElement>('.fig b')];
        nums.forEach((b) => (b.style.fontSize = '100px'));
        const scale = Math.min(...nums.map((b) => b.parentElement!.clientWidth / b.getBoundingClientRect().width));
        const size = Math.min(132, Math.floor(innerHeight * 0.14), Math.floor(100 * scale * 0.92));
        nums.forEach((b) => (b.style.fontSize = `${size}px`));
    }
    const fitAll = () => { fitName(); fitFigs(); };
    fitAll();
    document.fonts?.ready.then(fitAll);
    addEventListener('resize', fitAll);

    // ---- The season picker: button + listbox, keyboard as the old page's ----
    const one = main.querySelector<HTMLElement>('[data-one]')!;
    const pick = main.querySelector<HTMLElement>('[data-season]')!;
    const pickOpts = [...pick.querySelectorAll<HTMLElement>('.yp__opt')];
    // A one-season driver gets the year alone, with no button to wire
    const pickButton = pick.querySelector<HTMLButtonElement>('.yp__btn');
    if (pickButton) {
        const pickBtn: HTMLButtonElement = pickButton;
        const pickList = pick.querySelector<HTMLElement>('.yp__list')!;
        const pickThumb = pick.querySelector<HTMLElement>('.yp__thumb')!;
        const pickerOpen = () => pick.classList.contains('is-open');
        // The list's scroll thumb, as the page's (ScrollThumb.astro)
        let thumbTravel = 0, thumbRange = 0;
        const placeThumb = () => { pickThumb.style.transform = `translateY(${thumbRange > 0 ? (pickList.scrollTop / thumbRange) * thumbTravel : 0}px)`; };
        function measureThumb() {
            const vh = pickList.clientHeight, full = pickList.scrollHeight;
            thumbRange = full - vh;
            pickThumb.hidden = thumbRange <= 0;
            const h = Math.max(24, (vh / full) * vh);
            pickThumb.style.height = `${h}px`;
            thumbTravel = vh - h;
            placeThumb();
        }
        pickList.addEventListener('scroll', placeThumb, { passive: true });
        let dragY = 0, dragScroll = 0;
        pickThumb.addEventListener('pointerdown', (e) => {
            e.preventDefault();
            dragY = e.clientY; dragScroll = pickList.scrollTop;
            pickThumb.setPointerCapture(e.pointerId);
            pickThumb.classList.add('is-drag');
        });
        pickThumb.addEventListener('pointermove', (e) => {
            if (!pickThumb.hasPointerCapture(e.pointerId) || thumbTravel <= 0) return;
            pickList.scrollTop = dragScroll + ((e.clientY - dragY) / thumbTravel) * thumbRange;
        });
        const stopDrag = () => pickThumb.classList.remove('is-drag');
        pickThumb.addEventListener('pointerup', stopDrag);
        pickThumb.addEventListener('pointercancel', stopDrag);
        function openPicker() {
            pick.classList.add('is-open');
            pickBtn.setAttribute('aria-expanded', 'true');
            const sel = pickOpts.find((o) => o.getAttribute('aria-selected') === 'true') ?? pickOpts[0]!;
            // Scroll only the list (scrollIntoView would move the page as well)
            pickList.scrollTop = sel.offsetTop - pickList.offsetTop - (pickList.clientHeight - sel.offsetHeight) / 2;
            sel.focus({ preventScroll: true });
            measureThumb();
        }
        function closePicker(refocus = true) {
            if (!pickerOpen()) return;
            pick.classList.remove('is-open');
            pickBtn.setAttribute('aria-expanded', 'false');
            if (refocus) pickBtn.focus();
        }
        pickBtn.addEventListener('click', () => (pickerOpen() ? closePicker() : openPicker()));
        pickBtn.addEventListener('keydown', (e) => { if (e.key === 'ArrowDown' && !pickerOpen()) { e.preventDefault(); openPicker(); } });
        pickList.addEventListener('click', (e) => {
            const o = (e.target as HTMLElement).closest<HTMLElement>('.yp__opt');
            if (o) { closePicker(); drawSeason(Number(o.dataset.year)); }
        });
        pickList.addEventListener('keydown', (e) => {
            const i = pickOpts.indexOf(document.activeElement as HTMLElement);
            if (e.key === 'ArrowDown' || e.key === 'ArrowUp') { e.preventDefault(); pickOpts[Math.min(Math.max(i + (e.key === 'ArrowDown' ? 1 : -1), 0), pickOpts.length - 1)]!.focus(); }
            else if ((e.key === 'Enter' || e.key === ' ') && i >= 0) { e.preventDefault(); closePicker(); drawSeason(Number(pickOpts[i]!.dataset.year)); }
            else if (e.key === 'Escape') { e.preventDefault(); closePicker(); }
            else if (e.key === 'Tab') closePicker(false);
        });
        document.addEventListener('click', (e) => { if (!pick.contains(e.target as Node)) closePicker(false); });
    }

    // ---- The season panel: race cards on the curve, rows linked to points ----
    function wireSeason(year: number) {
        const s = D.seasons.find((x) => x.year === year)!;
        const rs = s.rounds;
        const plot = one.querySelector<HTMLElement>('.chart__plot')!;
        const tip = one.querySelector<HTMLElement>('[data-tip]')!;
        const dots = [...one.querySelectorAll<SVGElement>('.chart .dot')];
        const raced = rs.map((_, i) => i).filter((i) => !rs[i]!.missed && !rs[i]!.upcoming && (rs[i]!.out || rs[i]!.pos));
        const rows = [...one.querySelectorAll<HTMLElement>('.rounds tbody tr[data-i]')];
        const light = (i: number | null) => {
            const dot = i === null ? null : dots[raced.indexOf(i)];
            dots.forEach((d) => d.classList.toggle('is-on', d === dot));
            rows.forEach((row) => row.classList.toggle('is-hl', i !== null && Number(row.dataset.i) === i));
        };
        one.querySelectorAll<SVGElement>('.chart .hit').forEach((hit) => hit.addEventListener('mouseenter', () => {
            const i = Number(hit.dataset.i);
            const dot = dots[raced.indexOf(i)];
            if (!dot) return;
            tip.innerHTML = tipHtml(view, rs[i]!);
            const box = plot.getBoundingClientRect(), p = dot.getBoundingClientRect();
            const cx = p.left + p.width / 2 - box.left, cy = p.top + p.height / 2 - box.top;
            const left = Math.min(Math.max(cx - tip.offsetWidth / 2, 0), box.width - tip.offsetWidth);
            const below = cy + 16 + tip.offsetHeight <= box.height;
            // The first race shown appears in place; the next ones slide (owner, 18/10)
            const firstShown = !tip.classList.contains('is-on');
            tip.classList.toggle('is-instant', firstShown);
            tip.style.left = `${left}px`;
            tip.style.top = `${below ? cy + 16 : cy - 16 - tip.offsetHeight}px`;
            if (firstShown) { void tip.offsetWidth; tip.classList.remove('is-instant'); }
            tip.classList.add('is-on');
            light(i);
        }));
        // A row lights its point on the curve (no card: the curve may be off screen)
        rows.forEach((row) => row.addEventListener('mouseenter', () => light(Number(row.dataset.i))));
        one.querySelector('.rounds tbody')?.addEventListener('mouseleave', () => light(null));
        plot.addEventListener('mouseleave', () => { tip.classList.remove('is-on'); light(null); });
    }
    // A phone gets the form curve drawn for its width (driver-view.ts); the
    // build writes the wide one, so it's redrawn here when the page is narrow
    const phone = matchMedia('(max-width: 760px)');
    function drawSeason(year: number) {
        const s = D.seasons.find((x) => x.year === year);
        if (!s) return;
        one.innerHTML = seasonHtml(view, D, s, phone.matches);
        wireSeason(year);
        pick.querySelector('[data-value]')!.textContent = String(year);
        pickOpts.forEach((o) => o.setAttribute('aria-selected', String(Number(o.dataset.year) === year)));
        main.querySelectorAll<HTMLElement>('.sbs__bars, .sbs__row.y').forEach((b) => b.classList.toggle('sbs__sel', Number(b.dataset.y) === year));
    }
    const shownYear = () => Number(pick.querySelector('[data-value]')!.textContent);
    if (phone.matches) drawSeason(shownYear());
    else wireSeason(shownYear());
    phone.addEventListener('change', () => drawSeason(shownYear()));
    main.querySelectorAll<HTMLElement>('.sbs__bars').forEach((b) => b.addEventListener('click', () => {
        drawSeason(Number(b.dataset.y));
        document.getElementById('season')!.scrollIntoView({ behavior: 'smooth' });
    }));

    // ---- Season by season: on a phone it slides sideways ----------------------
    // It opens on the latest seasons (the ones a race weekend is about), and a
    // fade on either side says there's more that way
    {
        const wrap = main.querySelector<HTMLElement>('.sbs__wrap')!;
        const edges = () => {
            const end = wrap.scrollWidth - wrap.clientWidth;
            wrap.classList.toggle('fade-l', wrap.scrollLeft > 2);
            wrap.classList.toggle('fade-r', wrap.scrollLeft < end - 2);
        };
        wrap.scrollLeft = wrap.scrollWidth;
        edges();
        wrap.addEventListener('scroll', edges, { passive: true });
        addEventListener('resize', edges);

        // The position goes inside its bar only when it fits there with room
        // to spare: the figure grows with the column, so a share of the
        // height (16 %) left an 18th half outside a short bar (owner, 31/10)
        const bars = [...wrap.querySelectorAll<HTMLElement>('.sbs__bars')];
        const inside = () => bars.forEach((b) => {
            const fig = b.querySelector<HTMLElement>('span')!;
            b.classList.toggle('in', b.querySelector('i')!.offsetHeight >= fig.offsetHeight * 1.6);
        });
        inside();
        addEventListener('resize', inside);
    }

    // ---- Season by season: the teammate's whole surname ---------------------
    // Over a season's column (or with its bar focused) the rest of the surname
    // appears after its three letters, one letter after another, while the
    // column widens to fit it and the others give way; on the way out it all
    // runs backwards (owner, 31/10; it was typed out letter by letter before)
    {
        const grid = main.querySelector<HTMLElement>('.sbs__grid')!;
        const years = D.seasons.map((s) => String(s.year));
        const cols = years.length + 1;
        // Each widened column's share, kept while it closes
        const shares = new Map<string, number>();
        const closing = new Map<string, number>();
        let open: HTMLElement | null = null;
        // The same track list as the CSS, so the change animates
        const tracks = () => {
            const base = phone.matches ? '34px' : '0';
            return 'var(--lab) ' + years.map((y) => `minmax(${base}, ${shares.get(y) ?? 1}fr)`).join(' ');
        };
        const apply = () => (grid.style.gridTemplateColumns = tracks());
        // The share of the room the open column needs for the whole surname
        const shareOf = (el: HTMLElement) => {
            const n = years.length;
            const need = el.offsetWidth + (el.lastElementChild as HTMLElement).scrollWidth + 16;
            const room = grid.clientWidth - (grid.firstElementChild as HTMLElement).offsetWidth - 3 * n;
            return n > 1 && need > room / n ? Math.min((need * (n - 1)) / Math.max(room - need, 1), n) : 1;
        };
        const close = (el: HTMLElement) => {
            const y = el.dataset.y!;
            el.classList.remove('open');
            // The column narrows when its letters have gone, as .sbs__rest does
            const n = (el.lastElementChild as HTMLElement).children.length;
            closing.set(y, window.setTimeout(() => {
                shares.delete(y);
                closing.delete(y);
                apply();
            }, Math.max(0, (n - 1) * 45 - 150)));
        };
        const show = (cell: Element | null) => {
            const i = cell ? [...grid.children].indexOf(cell) % cols : 0;
            const year = i > 0 ? (grid.children[i] as HTMLElement).dataset.y : undefined;
            const el = year ? grid.querySelector<HTMLElement>(`.sbs__mate[data-y="${year}"]`) : null;
            if (el === open) return;
            if (open) close(open);
            if (el) {
                clearTimeout(closing.get(year!));
                closing.delete(year!);
                shares.set(year!, shareOf(el));
                const rest = el.lastElementChild as HTMLElement;
                rest.style.setProperty('--w', `${rest.scrollWidth}px`);
                el.classList.add('open');
            }
            apply();
            open = el;
        };
        // Set from the start: a change from the CSS's repeat() wouldn't animate
        apply();
        phone.addEventListener('change', apply);
        grid.addEventListener('mouseover', (e) => show((e.target as HTMLElement).closest('.sbs__grid > *')));
        grid.addEventListener('mouseleave', () => show(null));
        grid.addEventListener('focusin', (e) => show(e.target as HTMLElement));
        grid.addEventListener('focusout', () => show(null));
    }

    // ---- The ribbon's card follows the stretch under the pointer ----------
    {
        const rib = main.querySelector<HTMLElement>('.ribbon')!;
        const tip = rib.querySelector<HTMLElement>('.rtip')!;
        let shown: HTMLElement | null = null;
        rib.addEventListener('mouseover', (e) => {
            const el = (e.target as HTMLElement).closest<HTMLElement>('[data-tip]');
            if (!el || el === shown) return;
            shown = el;
            tip.innerHTML = ribTips[Number(el.dataset.tip)] ?? '';
            tip.style.setProperty('--tc', el.style.getPropertyValue('--c') || 'var(--paper)');
            const box = rib.getBoundingClientRect(), r = el.getBoundingClientRect();
            const left = Math.min(Math.max(r.left + r.width / 2 - box.left - tip.offsetWidth / 2, 0), box.width - tip.offsetWidth);
            const firstShown = !tip.classList.contains('is-on');
            tip.classList.toggle('is-instant', firstShown);
            tip.style.left = `${left}px`;
            tip.style.top = `${r.top - box.top - tip.offsetHeight - 16}px`;
            if (firstShown) { void tip.offsetWidth; tip.classList.remove('is-instant'); }
            tip.classList.add('is-on');
        });
        rib.addEventListener('mouseleave', () => { shown = null; tip.classList.remove('is-on'); });
    }

    // ---- The all-time board: on a tab switch the rows come up and count ----
    const boardEl = main.querySelector<HTMLElement>('[data-board]')!;
    function drawBoard(k: BoardStat) {
        boardEl.innerHTML = boardHtml(view, D, k);
        boardEl.classList.add('is-anim');
        if (!reduced) {
            boardEl.querySelectorAll<HTMLElement>('[data-v]').forEach((el, i) => {
                const to = Number(el.dataset.v), delay = i * 45 + 120, dur = 700, t0 = performance.now();
                el.textContent = fmt(view, 0);
                const step = (t: number) => {
                    const p = Math.min(Math.max((t - t0 - delay) / dur, 0), 1);
                    el.textContent = fmt(view, Math.round(to * (1 - Math.pow(1 - p, 3))));
                    if (p < 1) requestAnimationFrame(step);
                };
                requestAnimationFrame(step);
                // Lands on the value even if frames are held back (hidden tab)
                setTimeout(() => { el.textContent = fmt(view, to); }, delay + dur + 100);
            });
        }
        main.querySelectorAll<HTMLElement>('.tabs button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.k === k)));
    }
    main.querySelectorAll<HTMLElement>('.tabs button').forEach((b) => b.addEventListener('click', () => drawBoard(b.dataset.k as BoardStat)));

    // ---- Milestones ↔ grid ----------------------------------------------------
    {
        const grid = main.querySelector<HTMLElement>('.rows');
        let pinned: string | null = null;
        const mark = (key: string | null) => {
            main.querySelectorAll('.c.sel, .ledger__list li.sel').forEach((e) => e.classList.remove('sel'));
            grid?.classList.toggle('is-marking', Boolean(key));
            if (key) main.querySelectorAll(`[data-ms="${CSS.escape(key)}"]`).forEach((e) => e.classList.add('sel'));
            // The pinned one reads as pressed
            main.querySelectorAll<HTMLElement>('.ledger__list li[data-ms]').forEach((li) => li.querySelector('button')?.setAttribute('aria-pressed', String(Boolean(pinned) && li.dataset.ms === pinned)));
        };
        main.querySelectorAll<HTMLElement>('.ledger__list li[data-ms]:not([data-ms=""])').forEach((li) => {
            const key = li.dataset.ms!;
            li.addEventListener('mouseenter', () => mark(key));
            // The keyboard's focus marks it as the pointer does
            li.addEventListener('focusin', () => mark(key));
            li.addEventListener('focusout', () => mark(pinned));
            // A click (or Enter, Space: it's a button) pins it (the page scrolls
            // away from under the pointer); a second click, a click anywhere
            // else or Esc lets go (owner, 29/10)
            li.addEventListener('mouseleave', () => mark(pinned));
            li.addEventListener('click', () => {
                pinned = pinned === key ? null : key;
                mark(pinned);
                if (pinned) grid?.querySelector(`.c[data-ms="${CSS.escape(key)}"]`)?.scrollIntoView({ behavior: 'smooth', block: 'center' });
            });
        });
        document.addEventListener('click', (e) => {
            if (!pinned || (e.target as HTMLElement).closest('.ledger__list li')) return;
            pinned = null;
            mark(null);
        });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && pinned) { pinned = null; mark(null); } });
    }

    // ---- The site's own hover card for anything with data-tt ----------------
    // Never the browser's title tooltip (owner, 29/10, DESIGN.md). Lines split
    // on " · ", the first one leads; it slides from one item to the next.
    {
        const tt = document.createElement('div');
        tt.className = 'tt';
        tt.setAttribute('aria-hidden', 'true');
        document.body.append(tt);
        let on: HTMLElement | null = null, hide = 0;
        const escText = (s: string) => s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]!);
        // The keyboard's focus shows it too, on what can take focus (the
        // season bars); the rest carry the same words as hidden text
        document.addEventListener('focusin', (e) => show((e.target as HTMLElement).closest?.<HTMLElement>('[data-tt]') ?? null));
        document.addEventListener('focusout', () => show(null));
        document.addEventListener('mouseover', (e) => show((e.target as HTMLElement).closest?.<HTMLElement>('[data-tt]') ?? null));
        function show(el: HTMLElement | null) {
            if (el === on) return;
            on = el;
            // A short wait before hiding, so crossing the 2 px gap between two
            // races doesn't drop the card and bring it back
            if (!el || !el.dataset.tt?.trim()) { clearTimeout(hide); hide = window.setTimeout(() => tt.classList.remove('is-on'), 120); return; }
            clearTimeout(hide);
            const [head, ...rest] = el.dataset.tt.split(' · ');
            tt.innerHTML = `<b>${escText(head ?? '')}</b>${rest.map((l) => `<span>${escText(l)}</span>`).join('')}`;
            const r = el.getBoundingClientRect();
            const x = Math.min(Math.max(r.left + r.width / 2 - tt.offsetWidth / 2, 8), innerWidth - tt.offsetWidth - 8);
            const above = r.top - tt.offsetHeight - 12;
            const firstShown = !tt.classList.contains('is-on');
            tt.classList.toggle('is-instant', firstShown);
            tt.style.left = `${x}px`;
            tt.style.top = `${above > 64 ? above : r.bottom + 12}px`;
            if (firstShown) { void tt.offsetWidth; tt.classList.remove('is-instant'); }
            tt.classList.add('is-on');
        }
        addEventListener('scroll', () => { on = null; tt.classList.remove('is-on'); }, { passive: true });
    }
</script>
