---
// A driver's profile in every locale but English: /es/driver-preview/<id>/…
// The components read the language from Astro.currentLocale.
import DriverPage from '../../../components/driver/DriverPage.astro';
import { DEFAULT_LOCALE, LOCALES } from '../../../i18n';
import { DATA_DIR } from '../../../lib/data';
import { driverIds } from '../../../lib/driver';

export function getStaticPaths() {
    const ids = driverIds(DATA_DIR);
    return LOCALES.filter((lang) => lang !== DEFAULT_LOCALE).flatMap((lang) => ids.map((id) => ({ params: { lang, id } })));
}

const { id } = Astro.params;
---

<DriverPage id={id} />
