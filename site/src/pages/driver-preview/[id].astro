---
// A driver's profile in English, one page per driver in careers.json:
// /driver-preview/<id>/. A preview while the new site is built (kept out of
// search engines, not linked yet): the old drivers/driver.html?driver=<id>
// is still the live one. /drivers/ itself belongs to the old pages
// (LEGACY_PATHS), so the new profile can't live there until they go.
import DriverPage from '../../components/driver/DriverPage.astro';
import { DATA_DIR } from '../../lib/data';
import { driverIds } from '../../lib/driver';

export function getStaticPaths() {
    return driverIds(DATA_DIR).map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
---

<DriverPage id={id} />
